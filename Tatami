        .gantt-timeline {{ position: relative; min-height: 100%; }}

        .g-header {{
            display: flex;
            background: rgba(10, 18, 38, 0.98);
            position: sticky;
            top: 0;
            z-index: 25;
            border-bottom: 1px solid rgba(0,243,255,0.25);
        }}
        .g-month {{
            color: var(--neon-blue);
            font-size: 0.76rem;
            font-family: monospace;
            text-align: center;
            border-right: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            justify-content: center;
        }}

        .g-row-label {{
            padding: 0 10px;
            font-size: 0.82rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            cursor: pointer;
        }}
        .g-row-label:hover {{ background: rgba(0, 243, 255, 0.08); }}
        .g-row-bg {{ border-bottom: 1px solid rgba(255,255,255,0.03); position: absolute; width: 100%; left: 0; }}

        .g-bar {{
            position: absolute;
            height: 18px;
            border-radius: 3px;
            font-size: 0.7rem;
            font-weight: bold;
            display: flex;
            align-items: center;
            padding: 0 5px;
            overflow: hidden;
            white-space: nowrap;
            cursor: pointer;
            transition: filter 0.2s, transform 0.15s;
            z-index: 10;
        }}
        .g-bar:hover {{ filter: brightness(1.25); transform: scaleY(1.12); z-index: 20; }}

        .g-today-line {{
            position: absolute;
            top: 35px;
            bottom: 0;
            width: 2px;
            background: var(--neon-green);
            box-shadow: 0 0 8px var(--neon-green);
            z-index: 15;
            pointer-events: none;
        }}
        .g-today-label {{
            position: sticky;
            top: 36px;
            background: var(--neon-green);
            color: #000;
            font-size: 0.65rem;
            font-weight: bold;
            padding: 1px 4px;
            border-radius: 2px;
            transform: translateX(-50%);
            display: inline-block;
        }}

        /* Dependency SVG Layer */
        .dep-svg {{
            position: absolute;
            top: 0;
            left: 0;
            pointer-events: none;
            z-index: 6;
        }}
        .dep-path {{
            fill: none;
            stroke: rgba(0, 243, 255, 0.38);
            stroke-width: 1.4;
            transition: stroke 0.2s, stroke-width 0.2s, opacity 0.2s;
        }}
        .dep-path.dimmed {{ opacity: 0.12; }}
        .dep-path.highlighted {{
            stroke: #ff00ea;
            stroke-width: 2.5;
            opacity: 1;
            filter: drop-shadow(0 0 4px #ff00ea);
        }}

        /* Scrollbar */
        ::-webkit-scrollbar {{ width: 8px; height: 8px; }}
        ::-webkit-scrollbar-track {{ background: rgba(0,0,0,0.25); }}
        ::-webkit-scrollbar-thumb {{ background: rgba(0,243,255,0.3); border-radius: 4px; }}
        ::-webkit-scrollbar-thumb:hover {{ background: var(--neon-blue); }}
    </style>
</head>
<body>

    <div class="header">
        <div class="header-left">
            <h1>SYS-WBS DASHBOARD</h1>
            <span class="today-badge" id="todayDisplay">TODAY: ----/--/--</span>
        </div>
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('dashboard', this)">DETAILS &amp; CHARTS</button>
            <button class="tab-btn" onclick="switchTab('calendar', this)">GANTT CALENDAR</button>
        </div>
    </div>

    <!-- DASHBOARD VIEW -->
    <div id="view-dashboard" class="view-container view active">
        <!-- DEADLINE ALERT PANEL (COLLAPSIBLE) -->
        <div class="panel alert-panel" id="panel-alerts">
            <div class="panel-header" style="border-bottom-color: rgba(255, 42, 95, 0.3);">
                <div class="panel-title-clickable" onclick="togglePanel('panel-alerts')">
                    <span class="section-chevron">▼</span>
                    <span class="alert-title">DEADLINE ALERTS</span>
                    <span id="alertSummaryBadges"></span>
                </div>
                <div class="filter-bar" onclick="event.stopPropagation()">
                    <select id="alertThreshold" class="input-glow" onchange="refreshAlertsAndTable()">
                        <option value="7">7日以内を警告</option>
                        <option value="14" selected>14日以内を警告</option>
                        <option value="30">30日以内を警告</option>
                        <option value="60">60日以内を警告</option>
                    </select>
                    <select id="alertDateBasis" class="input-glow" onchange="refreshAlertsAndTable()">
                        <option value="deadline_or_end" selected>基準: 期限優先 (N/Aは終了日)</option>
                        <option value="deadline_only">基準: 「期限」列のみ</option>
                    </select>
                </div>
            </div>
            <div class="panel-body">
                <div class="alert-list" id="alertListContainer"></div>
            </div>
        </div>

        <!-- TOTAL PROGRESS & PHASE PROGRESS (COLLAPSIBLE) -->
        <div class="dashboard-grid">
            <div class="panel" id="panel-total-progress">
                <div class="panel-header">
                    <div class="panel-title-clickable" onclick="togglePanel('panel-total-progress')">
                        <span class="section-chevron">▼</span>
                        <span>TOTAL PROGRESS</span>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="pie-container" id="pie-chart-container"></div>
                </div>
            </div>

            <div class="panel" id="panel-phase-progress">
                <div class="panel-header">
                    <div class="panel-title-clickable" onclick="togglePanel('panel-phase-progress')">
                        <span class="section-chevron">▼</span>
                        <span>PHASE PROGRESS (Level 1)</span>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="bar-chart" id="bar-chart-container"></div>
                </div>
            </div>
        </div>

        <!-- TASK DETAILS TABLE -->
        <div class="panel" style="flex:1; min-height: 260px;">
            <div class="panel-header">
                <span>TASK DETAILS <small style="color:var(--text-muted); font-size:0.74rem; margin-left:6px;">(行クリックで詳細表示)</small></span>
                <div class="filter-bar">
                    <button class="mini-btn" onclick="expandAll()">すべて展開</button>
                    <button class="mini-btn" onclick="collapseAll()">すべて折りたたむ</button>
                    <label style="font-size:0.78rem; color:var(--text-main); display:flex; align-items:center; gap:5px; cursor:pointer;">
                        <input type="checkbox" id="alertOnlyCheck" onchange="applyFilter()"> アラート対象のみ
                    </label>
                    <input type="text" id="searchInput" class="input-glow" placeholder="タスク名 / ID 検索..." onkeyup="applyFilter()">
                    <select id="resourceFilter" class="input-glow" onchange="applyFilter()">
                        <option value="">すべてのリソース</option>
                    </select>
                </div>
            </div>
            <div class="table-container">
                <table id="wbs-table">
                    <thead>
                        <tr>
                            <th style="width: 65px;">ID</th>
                            <th>タスク名</th>
                            <th style="width: 140px;">達成率</th>
                            <th style="width: 120px;">期間 / 工数</th>
                            <th style="width: 105px;">開始日</th>
                            <th style="width: 105px;">終了日</th>
                            <th style="width: 105px;">期限</th>
                            <th style="width: 130px;">リソース</th>
                            <th style="width: 110px;">先行 / 後続</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- CALENDAR (GANTT) VIEW -->
    <div id="view-calendar" class="view-container view">
        <div class="gantt-toolbar">
            <div class="filter-bar">
                <button class="mini-btn" onclick="expandAll()">すべて展開</button>
                <button class="mini-btn" onclick="collapseAll()">すべて折りたたむ</button>
                <button class="mini-btn active" id="toggleDepBtn" onclick="toggleDepLines()">依存関係線: ON</button>
                <select id="ganttZoom" class="input-glow" onchange="renderGantt()">
                    <option value="3">表示倍率: 広域 (3px/日)</option>
                    <option value="5" selected>表示倍率: 標準 (5px/日)</option>
                    <option value="9">表示倍率: 詳細 (9px/日)</option>
                </select>
            </div>
            <div class="gantt-legend">
                <span><i class="legend-dot" style="background:var(--neon-purple);"></i>Level 1</span>
                <span><i class="legend-dot" style="background:var(--neon-blue);"></i>通常タスク</span>
                <span><i class="legend-dot" style="background:var(--neon-amber);"></i>期限間近</span>
                <span><i class="legend-dot" style="background:var(--neon-red);"></i>期限超過</span>
                <span><i class="legend-dot" style="background:var(--neon-green);"></i>TODAY</span>
            </div>
        </div>
        <div class="gantt-wrapper">
            <div class="gantt-labels" id="gantt-labels"></div>
            <div class="gantt-timeline-container" id="gantt-scroll" onscroll="syncScroll()">
                <div class="gantt-timeline" id="gantt-timeline"></div>
            </div>
        </div>
    </div>

    <!-- GRAPHICAL TASK DETAIL DRAWER -->
    <div class="drawer-backdrop" id="drawerBackdrop" onclick="closeTaskDetail()"></div>
    <aside class="task-drawer" id="taskDrawer">
        <div class="drawer-header">
            <div style="flex:1; min-width:0;">
                <div class="drawer-breadcrumbs" id="drawerBreadcrumbs"></div>
                <div class="drawer-title-row">
                    <span class="drawer-id-tag" id="drawerTaskId">ID: -</span>
                    <span id="drawerAlertBadge"></span>
                </div>
                <div class="drawer-task-name" id="drawerTaskName" style="margin-top:6px;">タスクを選択してください</div>
            </div>
            <button class="drawer-close-btn" onclick="closeTaskDetail()" title="閉じる (ESC)">✕</button>
        </div>
        <div class="drawer-body" id="drawerBody"></div>
    </aside>

    <script>
        let tasks = {json_data};
        let collapsedNodes = new Set();
        let isFiltering = false;
        let showDepLines = true;
        let selectedTaskId = null;

        // 今日の日付（00:00:00基準）
        const now = new Date();
        const todayDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const todayStr = `${{todayDate.getFullYear()}}-${{String(todayDate.getMonth() + 1).padStart(2, '0')}}-${{String(todayDate.getDate()).padStart(2, '0')}}`;

        function parseLocalDate(isoStr) {{
            if (!isoStr) return null;
            const parts = isoStr.split('-');
            if (parts.length !== 3) return null;
            return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
        }}

        function escapeHtml(str) {{
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }}

        function togglePanel(panelId) {{
            const panel = document.getElementById(panelId);
            if (panel) panel.classList.toggle('collapsed');
        }}

        function initData() {{
            document.getElementById('todayDisplay').textContent = `TODAY: ${{todayStr}}`;

            // PHASE PROGRESS: Level 1タスクの進捗を配下タスクの平均から自動計算
            const topLvlStats = {{}};
            tasks.forEach(t => {{
                if (t.level === 1) topLvlStats[t.id] = {{ sum: 0, count: 0 }};
            }});

            tasks.forEach(t => {{
                if (t.level > 1 && t.top_parent_id && topLvlStats[t.top_parent_id]) {{
                    topLvlStats[t.top_parent_id].sum += parseFloat(t.progress || 0);
                    topLvlStats[t.top_parent_id].count++;
                }}
            }});

            tasks.forEach(t => {{
                if (t.level === 1 && topLvlStats[t.id].count > 0) {{
                    t.progress = topLvlStats[t.id].sum / topLvlStats[t.id].count;
                }}
            }});

            // リソースフィルター選択肢
            const resources = [...new Set(tasks.map(t => t.resource).filter(r => r))];
            const resSelect = document.getElementById('resourceFilter');
            resources.forEach(r => {{
                const opt = document.createElement('option');
                opt.value = r;
                opt.textContent = r;
                resSelect.appendChild(opt);
            }});
        }}

        function getAlertInfo(t) {{
            if (parseFloat(t.progress || 0) >= 0.999) return null;

            const threshold = parseInt(document.getElementById('alertThreshold').value, 10);
            const basis = document.getElementById('alertDateBasis').value;

            let targetStr = '';
            let basisLabel = '';
            if (basis === 'deadline_only') {{
                targetStr = t.deadline;
                basisLabel = '期限';
            }} else {{
                if (t.deadline) {{
                    targetStr = t.deadline;
                    basisLabel = '期限';
                }} else if (t.end) {{
                    targetStr = t.end;
                    basisLabel = '終了日';
                }}
            }}

            const targetDate = parseLocalDate(targetStr);
            if (!targetDate) return null;

            const diffDays = Math.round((targetDate - todayDate) / (1000 * 60 * 60 * 24));
            if (diffDays < 0) {{
                return {{ type: 'overdue', diffDays, targetStr, basisLabel, label: `${{Math.abs(diffDays)}}日超過` }};
            }} else if (diffDays <= threshold) {{
                const dayText = diffDays === 0 ? '本日期限' : `あと${{diffDays}}日`;
                return {{ type: 'soon', diffDays, targetStr, basisLabel, label: dayText }};
            }}
            return null;
        }}

        function renderAlerts() {{
            const container = document.getElementById('alertListContainer');
            const summaryContainer = document.getElementById('alertSummaryBadges');

            const alerted = [];
            tasks.forEach(t => {{
                const info = getAlertInfo(t);
                if (info) alerted.push({{ task: t, info }});
            }});

            alerted.sort((a, b) => a.info.diffDays - b.info.diffDays);

            const overdueCount = alerted.filter(a => a.info.type === 'overdue').length;
            const soonCount = alerted.
