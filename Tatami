def clean_val(val):
    if pd.isna(val):
        return ""
    val_str = str(val).replace('?', '').strip()
    if val_str.lower() == "nan":
        return ""
    return val_str


def clean_id(val):
    """Excel数値読み込み時の '.0' 付与を除去してID文字列を正規化"""
    s = clean_val(val)
    if not s:
        return ""
    return re.sub(r'\.0$', '', s)


def parse_id_list(val):
    """カンマ区切りなどの先行・後続タスクIDを配列化"""
    s = clean_val(val)
    if not s or s == "N/A":
        return []
    parts = re.split(r'[,、\s]+', s)
    result = []
    for p in parts:
        cleaned = re.sub(r'\.0$', '', p.strip())
        if cleaned:
            result.append(cleaned)
    return result


def get_col_val(row, col_names, df_columns):
    for name in col_names:
        if name in df_columns:
            return clean_val(row[name])
    return ""


def format_date_iso(date_str):
    """「YYYY年MM月DD日 8:00」や「26/01/15 (木)」を「YYYY-MM-DD」に正規化"""
    if not date_str or str(date_str) == "N/A":
        return ""
    s = str(date_str).strip()

    # 4桁年 (例: 2025年10月15日 8:00, 2025/10/15, 2025-10-15)
    m4 = re.search(r'(\d{4})[年/\-](\d{1,2})[月/\-](\d{1,2})', s)
    if m4:
        return f"{int(m4.group(1)):04d}-{int(m4.group(2)):02d}-{int(m4.group(3)):02d}"

    # 2桁年 (例: 26/01/15 (木))
    m2 = re.search(r'(?<!\d)(\d{2})[年/\-](\d{1,2})[月/\-](\d{1,2})', s)
    if m2:
        year = 2000 + int(m2.group(1))
        return f"{year:04d}-{int(m2.group(2)):02d}-{int(m2.group(3)):02d}"

    return ""


def main():
    root = tk.Tk()
    root.withdraw()
    file_path = filedialog.askopenfilename(
        title="WBSのExcelまたはCSVファイルを選択してください",
        filetypes=[("Excel files", "*.xlsx *.xls"), ("CSV files", "*.csv")]
    )

    if not file_path:
        print("キャンセルされました。")
        return

    try:
        if file_path.endswith('.csv'):
            try:
                df = pd.read_csv(file_path, encoding='utf-8-sig')
            except Exception:
                df = pd.read_csv(file_path, encoding='cp932')
        else:
            df = pd.read_excel(file_path)

        tasks = []
        last_at_level = {}
        top_level_id = None

        for _, row in df.iterrows():
            raw_prog = get_col_val(row, ["達成率", "進捗率"], df.columns)
            try:
                progress = float(raw_prog)
            except Exception:
                progress = 0.0

            lvl_str = clean_id(get_col_val(row, ["アウトライン_レベル", "アウトライン"], df.columns))
            try:
                lvl = int(lvl_str)
            except Exception:
                lvl = 1

            task_id = clean_id(get_col_val(row, ["ID", "ＩＤ"], df.columns))
            if not task_id:
                continue

            # 親子関係の特定
            parent_id = None
            if lvl == 1:
                top_level_id = task_id
            elif lvl > 1:
                parent_id = last_at_level.get(lvl - 1)

            last_at_level[lvl] = task_id

            # HTML作成対象外の列（総合余裕期間、成果物ID/タイプ/ステータス、固有ID、作業時間仮設定）は除外
            task = {
                'id': task_id,
                'level': lvl,
                'parent_id': parent_id,
                'top_parent_id': top_level_id if lvl > 1 else task_id,
                'name': get_col_val(row, ["タスク名"], df.columns),
                'work_hours': get_col_val(row, ["作業時間"], df.columns),
                'duration': get_col_val(row, ["期間"], df.columns),
                'start': format_date_iso(get_col_val(row, ["開始日"], df.columns)),
                'end': format_date_iso(get_col_val(row, ["終了日"], df.columns)),
                'deadline': format_date_iso(get_col_val(row, ["期限"], df.columns)),
                'resource': get_col_val(row, ["リソース名", "リソース"], df.columns),
                'stakeholder': get_col_val(row, ["関係者"], df.columns),
                'predecessors': parse_id_list(get_col_val(row, ["先行タスク"], df.columns)),
                'successors': parse_id_list(get_col_val(row, ["後続タスク"], df.columns)),
                'progress': progress,
                'has_children': False
            }
            tasks.append(task)

        # 子タスクを持つ親タスクのフラグ設定
        parent_ids = {t['parent_id'] for t in tasks if t['parent_id']}
        for t in tasks:
            if t['id'] in parent_ids:
                t['has_children'] = True

        json_data = json.dumps(tasks, ensure_ascii=False)

