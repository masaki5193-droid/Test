                                </div>
                                <span style="font-family:monospace; font-size:0.75rem; color:var(--neon-blue);">${sp}%</span>
                            </div>
                        </div>`;
                }).join('');

                subTasksHtml = `
                    <div class="hud-card">
                        <div class="hud-card-title">
                            <span>SUB-TASKS HIERARCHY (${subTasks.length}件)</span>
