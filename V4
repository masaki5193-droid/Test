            flex-shrink: 0;
        }

        .heatmap-table { border-collapse: collapse; font-family: monospace; font-size: 0.74rem; }
        .heatmap-table th, .heatmap-table td {
            border: 1px solid rgba(255, 255, 255, 0.06);
            padding: 5px 6px;
            text-align: center;
            min-width: 44px;
            white-space: nowrap;
        }
        .heatmap-table th.sticky-res, .heatmap-table td.sticky-res {
            position: sticky;
            left: 0;
            background: rgba(10, 18, 38, 0.98);
            z-index: 12;
            text-align: left;
            min-width: 150px;
            max-width: 180px;
            overflow: hidden;
            text-overflow: ellipsis;
            font-family: 'Segoe UI', system-ui, sans-serif;
            font-weight: bold;
            color: var(--neon-blue);
        }
        .hm-cell { cursor: pointer; transition: transform 0.12s; }
        .hm-cell:hover { outline: 1px solid #fff; z-index: 5; position: relative; }
        .hm-cell.hm-selected {
            outline: 2px solid var(--neon-purple) !important;
            box-shadow: inset 0 0 8px var(--neon-purple);
            z-index: 6;
            position: relative;
        }
        .hm-0 { color: rgba(255,255,255,0.18); }
        .hm-low { background: rgba(0, 243, 255, 0.14); color: #a5f3fc; }
        .hm-mid { background: rgba(0, 243, 255, 0.34); color: #ffffff; font-weight: bold; }
        .hm-high { background: rgba(255, 170, 0, 0.35); color: #fde68a; font-weight: bold; }
        .hm-over { background: rgba(255, 42, 95, 0.48); color: #ffffff; font-weight: bold; box-shadow: inset 0 0 6px var(--neon-red); }
        .hm-weekend { background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.02) 0, rgba(255,255,255,0.02) 4px, transparent 4px, transparent 8px); }

        /* =========================================================
           TASK DETAIL HUD DRAWER (GRAPHICAL INSPECTOR)
        ========================================================= */
        .drawer-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(2, 6, 18, 0.58);
            backdrop-filter: blur(3px);
            z-index: 200;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }
        .drawer-backdrop.open {
            opacity: 1;
            pointer-events: auto;
        }
        .task-drawer {
            position: fixed;
            top: 0;
            right: 0;
            width: 680px;
            max-width: 96vw;
            height: 100vh;
            background: linear-gradient(180deg, rgba(10, 19, 42, 0.98) 0%, rgba(4, 9, 22, 0.99) 100%);
            border-left: 1px solid var(--neon-blue);
            box-shadow: -10px 0 40px rgba(0, 0, 0, 0.85), 0 0 24px rgba(0, 243, 255, 0.18);
            z-index: 210;
            transform: translateX(102%);
            transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .task-drawer.open {
            transform: translateX(0);
        }
        .drawer-header {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(0, 243, 255, 0.25);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            background: rgba(0, 243, 255, 0.04);
        }
        .drawer-breadcrumbs {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            align-items: center;
            font-size: 0.74rem;
            color: var(--text-muted);
            margin-bottom: 6px;
        }
        .crumb-link {
            color: var(--neon-blue);
            cursor: pointer;
            text-decoration: underline;
            text-underline-offset: 2px;
        }
        .crumb-link:hover { color: #fff; }
        .drawer-title-row {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }
        .drawer-id-tag {
            font-family: monospace;
            font-size: 0.8rem;
            padding: 2px 8px;
            border-radius: 4px;
            background: rgba(188, 19, 254, 0.2);
            border: 1px solid var(--neon-purple);
            color: #e9a8ff;
        }
        .drawer-task-name {
            font-size: 1.12rem;
            font-weight: bold;
            color: #fff;
            line-height: 1.35;
        }
        .drawer-close-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--text-main);
            width: 32px;
            height: 32px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1.1rem;
            flex-shrink: 0;
            transition: 0.2s;
        }
        .drawer-close-btn:hover {
            border-color: var(--neon-red);
            color: var(--neon-red);
            background: rgba(255, 42, 95, 0.15);
        }

        .drawer-body {
            flex: 1;
            overflow-y: auto;
            padding: 18px 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .hud-card {
            background: rgba(13, 24, 52, 0.65);
            border: 1px solid rgba(0, 243, 255, 0.2);
            border-radius: 8px;
            padding: 14px;
        }
        .hud-card-title {
            font-size: 0.78rem;
            font-family: monospace;
            letter-spacing: 1.5px;
            color: var(--neon-blue);
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
        }

        .progress-hud-grid {
            display: grid;
            grid-template-columns: 130px 1fr;
            gap: 16px;
            align-items: center;
        }
        .dual-bar-group { display: flex; flex-direction: column; gap: 12px; }
        .dual-bar-row { display: flex; flex-direction: column; gap: 4px; }
        .dual-bar-label { display: flex; justify-content: space-between; font-size: 0.78rem; }
        .dual-bar-track {
            height: 8px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 4px;
            overflow: hidden;
            position: relative;
        }
        .dual-bar-fill-actual {
            height: 100%;
            background: linear-gradient(90deg, var(--neon-purple), var(--neon-green));
            box-shadow: 0 0 8px var(--neon-green);
            border-radius: 4px;
        }
        .dual-bar-fill-time {
            height: 100%;
            background: linear-gradient(90deg, #3b82f6, var(--neon-blue));
            box-shadow: 0 0 8px var(--neon-blue);
            border-radius: 4px;
        }

        .telemetry-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }
        .tele-box {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 6px;
            padding: 8px 10px;
        }
        .tele-label { font-size: 0.7rem; color: var(--text-muted); margin-bottom: 3px; }
        .tele-val { font-size: 0.88rem; font-weight: bold; font-family: monospace; color: var(--text-main); word-break: break-all; }

        /* Full Chain Dependency Flow Diagram */
        .dep-diagram-wrap {
            width: 100%;
            overflow-x: auto;
            overflow-y: auto;
            max-height: 360px;
            background: rgba(2, 6, 18, 0.75);
            border: 1px solid rgba(0, 243, 255, 0.25);
            border-radius: 6px;
            padding: 10px;
        }
        .dep-node-box { cursor: pointer; transition: opacity 0.2s; }
        .dep-node-box:hover { opacity: 0.85; }
        .current-node-pulse {
            animation: targetNodePulse 1.8s infinite ease-in-out;
        }

        .subtask-mini-list { display: flex; flex-direction: column; gap: 6px; max-height: 190px; overflow-y: auto; }
        .subtask-mini-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 7px 10px;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.8rem;
        }
        .subtask-mini-item:hover { border-color: var(--neon-blue); background: rgba(0, 243, 255, 0.08); }

        /* Gantt Chart */
        .gantt-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            padding: 8px 14px;
            background: var(--panel-bg);
            border: 1px solid var(--border-glow);
            border-radius: 6px;
            flex-wrap: wrap;
            gap: 10px;
        }
        .gantt-legend { display: flex; gap: 14px; font-size: 0.78rem; color: var(--text-muted); align-items: center; flex-wrap: wrap; }
        .legend-dot { width: 10px; height: 10px; border-radius: 2px; display: inline-block; margin-right: 4px; }

        .gantt-wrapper {
            display: flex;
            flex: 1;
            min-height: 0;
            background: var(--panel-bg);
            border: 1px solid var(--border-glow);
            border-radius: 8px;
            overflow: hidden;
        }
        .gantt-labels {
            width: 320px;
            flex-shrink: 0;
            border-right: 1px solid rgba(0,243,255,0.25);
            overflow-y: hidden;
            background: rgba(3, 7, 18, 0.55);
        }
        .gantt-timeline-container { flex: 1; overflow: auto; position: relative; }
        .gantt-timeline { position: relative; min-height: 100%; }

        .g-header {
            display: flex;
            background: rgba(10, 18, 38, 0.98);
            position: sticky;
            top: 0;
            z-index: 25;
            border-bottom: 1px solid rgba(0,243,255,0.25);
        }
        .g-month {
            color: var(--neon-blue);
            font-size: 0.76rem;
            font-family: monospace;
            text-align: center;
            border-right: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .g-row-label {
            padding: 0 10px;
            font-size: 0.82rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            cursor: pointer;
        }
        .g-row-label:hover { background: rgba(0, 243, 255, 0.08); }
        .g-row-bg { border-bottom: 1px solid rgba(255,255,255,0.03); position: absolute; width: 100%; left: 0; }

        .g-bar {
            position: absolute;
            height: 18px;
            border-radius: 3px;
            font-size: 0.7rem;
            font-weight: bold;
            display: flex;
            align-items: center;
            padding: 0 5px;
            overflow: hidden;
            white-space: nowrap;
            cursor: pointer;
            z-index: 10;
            transform-origin: left center;
            animation: ganttBarGrow 0.65s cubic-bezier(0.16, 1, 0.3, 1) backwards;
            transition: filter 0.2s, box-shadow 0.2s;
        }
        .g-bar:hover {
            filter: brightness(1.3);
            z-index: 20;
        }

        .g-today-line {
            position: absolute;
            top: 35px;
            bottom: 0;
            width: 2px;
            background: var(--neon-green);
            box-shadow: 0 0 8px var(--neon-green);
            z-index: 15;
            pointer-events: none;
        }
        .g-today-label {
            position: sticky;
            top: 36px;
            background: var(--neon-green);
            color: #000;
            font-size: 0.65rem;
            font-weight: bold;
            padding: 1px 4px;
            border-radius: 2px;
            transform: translateX(-50%);
            display: inline-block;
        }

        .dep-svg {
            position: absolute;
            top: 0;
            left: 0;
            pointer-events: none;
            z-index: 6;
            animation: depFadeIn 0.8s ease 0.3s backwards;
        }
        .dep-path {
            fill: none;
            stroke: rgba(0, 243, 255, 0.42);
            stroke-width: 1.4;
            transition: stroke 0.2s, stroke-width 0.2s, opacity 0.2s;
        }
        .dep-path.dimmed { opacity: 0.12; }
        .dep-path.highlighted {
            stroke: #ff00ea;
            stroke-width: 2.5;
            opacity: 1;
            filter: drop-shadow(0 0 4px #ff00ea);
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: rgba(0,0,0,0.25); }
        ::-webkit-scrollbar-thumb { background: rgba(0,243,255,0.3); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--neon-blue); }

        /* =========================================================
           PRINT STYLESHEET (CLEAN REPORT FORMAT)
        ========================================================= */
        .print-only-banner { display: none; }

        @media print {
            @page {
                size: A4 landscape;
                margin: 10mm;
            }
            * {
                animation: none !important;
                transition: none !important;
                box-shadow: none !important;
                text-shadow: none !important;
                backdrop-filter: none !important;
            }
            body {
                background: #ffffff !important;
                color: #111827 !important;
                height: auto !important;
                overflow: visible !important;
                display: block !important;
            }
            .boot-scanline,
            .tabs,
            .print-btn,
            .filter-bar,
            .section-chevron,
            .toggle-btn,
            .gantt-toolbar,
            .drawer-backdrop,
            .task-drawer {
                display: none !important;
            }
            .print-only-banner {
                display: flex !important;
                justify-content: space-between;
                align-items: center;
                border-bottom: 2px solid #1e293b;
                padding-bottom: 6px;
                margin-bottom: 12px;
                font-size: 0.85rem;
                color: #334155;
            }
            .header {
                background: #ffffff !important;
                border-bottom: 2px solid #0f172a !important;
                padding: 8px 0 !important;
                margin-bottom: 10px;
            }
            .header h1 {
                color: #0f172a !important;
                font-size: 1.5rem !important;
            }
            .today-badge {
                border: 1px solid #475569 !important;
                color: #0f172a !important;
                background: #f1f5f9 !important;
            }
            .view-container {
                overflow: visible !important;
                padding: 0 !important;
                height: auto !important;
            }
            .view.active {
                display: block !important;
                height: auto !important;
            }
            .panel {
                background: #ffffff !important;
                border: 1px solid #cbd5e1 !important;
                margin-bottom: 12px !important;
                padding: 10px 12px !important;
                page-break-inside: avoid;
            }
            .panel.collapsed .panel-body {
                display: block !important;
            }
            .panel-header {
                color: #0f172a !important;
                border-bottom: 1px solid #94a3b8 !important;
                font-weight: bold !important;
            }
            .alert-title { color: #b91c1c !important; }
            .alert-list {
                flex-wrap: wrap !important;
                overflow: visible !important;
            }
            .alert-card {
                background: #fff5f5 !important;
                border: 1px solid #fecaca !important;
                border-left: 4px solid #dc2626 !important;
                color: #111827 !important;
                min-width: 190px !important;
            }
            .dashboard-grid {
                grid-template-columns: 220px 1fr !important;
                page-break-inside: avoid;
            }
            .bar-chart {
                max-height: none !important;
                overflow: visible !important;
            }
            .bar-track {
                background: #e2e8f0 !important;
                border: 1px solid #cbd5e1;
            }
            .bar-fill {
                background: #2563eb !important;
            }
            .bar-percent { color: #1e293b !important; }
            svg text { fill: #0f172a !important; }
            .table-container {
                overflow: visible !important;
            }
            table {
                width: 100% !important;
                border: 1px solid #cbd5e1 !important;
            }
            thead {
                display: table-header-group;
            }
            tr {
                page-break-inside: avoid;
            }
            th {
                background: #f1f5f9 !important;
                color: #0f172a !important;
                border-bottom: 2px solid #64748b !important;
                position: static !important;
            }
            td {
                color: #1e293b !important;
                border-bottom: 1px solid #e2e8f0 !important;
            }
            .lvl-1 {
                background: #f8fafc !important;
                border-left: 3px solid #2563eb !important;
            }
            tr.row-overdue { background: #fef2f2 !important; }
            tr.row-soon { background: #fffbeb !important; }
            .pill-overdue { background: #fee2e2 !important; color: #b91c1c !important; border-color: #dc2626 !important; }
            .pill-soon { background: #fef3c7 !important; color: #b45309 !important; border-color: #d97706 !important; }
            .gantt-wrapper, .res-chart-scroll {
                background: #ffffff !important;
                border: 1px solid #cbd5e1 !important;
                overflow: visible !important;
            }
            .gantt-labels {
                background: #f8fafc !important;
                border-right: 1px solid #94a3b8 !important;
            }
            .g-row-label { color: #0f172a !important; border-bottom: 1px solid #e2e8f0 !important; }
            .g-header { background: #f1f5f9 !important; position: static !important; }
            .g-month { color: #0f172a !important; border-right: 1px solid #cbd5e1 !important; }
            .heatmap-table th, .heatmap-table td {
                border: 1px solid #cbd5e1 !important;
                color: #0f172a !important;
            }
            .heatmap-table th.sticky-res, .heatmap-table td.sticky-res {
                background: #f1f5f9 !important;
                color: #0f172a !important;
                position: static !important;
            }
        }
    </style>
</head>
<body>

    <div class="boot-scanline"></div>

    <div class="print-only-banner">
        <span>PROJECT WBS MANAGEMENT REPORT</span>
        <span id="printTimestamp">PRINTED: ----/--/--</span>
    </div>

    <div class="header animate-header">
        <div class="header-left">
            <h1>WBS DASHBOARD</h1>
            <span class="today-badge" id="todayDisplay">TODAY: ----/--/--</span>
        </div>
        <div class="header-right">
            <div class="tabs">
                <button class="tab-btn active" onclick="switchTab('dashboard', this)">DETAILS &amp; CHARTS</button>
                <button class="tab-btn" onclick="switchTab('calendar', this)">GANTT CALENDAR</button>
                <button class="tab-btn" onclick="switchTab('resources', this)">RESOURCE WORKLOAD</button>
            </div>
            <button class="print-btn" onclick="triggerPrint()" title="印刷・PDF保存用に整形して出力">🖨 PRINT / PDF</button>
        </div>
    </div>

    <!-- =========================================================
         VIEW 1: DASHBOARD & TASK DETAILS
    ========================================================= -->
    <div id="view-dashboard" class="view-container view active">
        <!-- DEADLINE ALERT PANEL (COLLAPSIBLE) -->
        <div class="panel alert-panel animate-panel delay-1" id="panel-alerts">
            <div class="panel-header" style="border-bottom-color: rgba(255, 42, 95, 0.3);">
                <div class="panel-title-clickable" onclick="togglePanel('panel-alerts')">
                    <span class="section-chevron">▼</span>
                    <span class="alert-title">DEADLINE ALERTS</span>
                    <span id="alertSummaryBadges"></span>
                </div>
                <div class="filter-bar" onclick="event.stopPropagation()">
                    <select id="alertThreshold" class="input-glow" onchange="refreshAlertsAndTable()">
                        <option value="7">7日以内を警告</option>
                        <option value="14" selected>14日以内を警告</option>
                        <option value="30">30日以内を警告</option>
                        <option value="60">60日以内を警告</option>
                    </select>
                    <select id="alertDateBasis" class="input-glow" onchange="refreshAlertsAndTable()">
                        <option value="deadline_or_end" selected>基準: 期限優先 (N/Aは終了日)</option>
                        <option value="deadline_only">基準: 「期限」列のみ</option>
                    </select>
                </div>
            </div>
            <div class="panel-body">
                <div class="alert-list" id="alertListContainer"></div>
            </div>
        </div>

        <!-- TOTAL PROGRESS & PHASE PROGRESS (COLLAPSIBLE) -->
        <div class="dashboard-grid animate-panel delay-2">
            <div class="panel" id="panel-total-progress">
                <div class="panel-header">
                    <div class="panel-title-clickable" onclick="togglePanel('panel-total-progress')">
                        <span class="section-chevron">▼</span>
                        <span>TOTAL PROGRESS</span>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="pie-container" id="pie-chart-container"></div>
                </div>
            </div>

            <div class="panel" id="panel-phase-progress">
                <div class="panel-header">
                    <div class="panel-title-clickable" onclick="togglePanel('panel-phase-progress')">
                        <span class="section-chevron">▼</span>
                        <span>PHASE PROGRESS (Level 1)</span>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="bar-chart" id="bar-chart-container"></div>
                </div>
            </div>
        </div>

        <!-- TASK DETAILS TABLE -->
        <div class="panel animate-panel delay-3" style="flex:1; min-height: 260px;">
            <div class="panel-header">
                <span>TASK DETAILS <small style="color:var(--text-muted); font-size:0.74rem; margin-left:6px;">(行クリックで詳細・全依存チェーン表示)</small></span>
                <div class="filter-bar">
                    <button class="mini-btn" onclick="expandAll()">すべて展開</button>
                    <button class="mini-btn" onclick="collapseAll()">すべて折りたたむ</button>
                    <label style="font-size:0.78rem; color:var(--text-main); display:flex; align-items:center; gap:5px; cursor:pointer;">
                        <input type="checkbox" id="alertOnlyCheck" onchange="applyFilter()"> アラート対象のみ
                    </label>
                    <input type="text" id="searchInput" class="input-glow" placeholder="タスク名 / ID 検索..." onkeyup="applyFilter()">
                    <select id="resourceFilter" class="input-glow" onchange="applyFilter()">
                        <option value="">すべてのリソース</option>
                    </select>
                </div>
            </div>
            <div class="table-container">
                <table id="wbs-table">
                    <thead>
                        <tr>
                            <th style="width: 65px;">ID</th>
                            <th>タスク名</th>
                            <th style="width: 140px;">達成率</th>
                            <th style="width: 120px;">期間 / 工数</th>
                            <th style="width: 105px;">開始日</th>
                            <th style="width: 105px;">終了日</th>
                            <th style="width: 105px;">期限</th>
                            <th style="width: 130px;">リソース</th>
                            <th style="width: 110px;">先行 / 後続</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- =========================================================
         VIEW 2: CALENDAR (GANTT) VIEW
    ========================================================= -->
    <div id="view-calendar" class="view-container view">
        <div class="gantt-toolbar animate-panel delay-1">
            <div class="filter-bar">
                <button class="mini-btn" onclick="expandAll()">すべて展開</button>
                <button class="mini-btn" onclick="collapseAll()">すべて折りたたむ</button>
                <button class="mini-btn active" id="toggleDepBtn" onclick="toggleDepLines()">依存関係線: ON</button>
                <select id="ganttZoom" class="input-glow" onchange="renderGantt()">
                    <option value="3">表示倍率: 広域 (3px/日)</option>
                    <option value="5" selected>表示倍率: 標準 (5px/日)</option>
                    <option value="9">表示倍率: 詳細 (9px/日)</option>
                </select>
            </div>
            <div class="gantt-legend">
                <span><i class="legend-dot" style="background:var(--neon-purple);"></i>Level 1</span>
                <span><i class="legend-dot" style="background:var(--neon-blue);"></i>通常タスク</span>
                <span><i class="legend-dot" style="background:var(--neon-amber);"></i>期限間近</span>
                <span><i class="legend-dot" style="background:var(--neon-red);"></i>期限超過</span>
                <span><i class="legend-dot" style="background:var(--neon-green);"></i>TODAY</span>
            </div>
        </div>
        <div class="gantt-wrapper animate-panel delay-2">
            <div class="gantt-labels" id="gantt-labels"></div>
            <div class="gantt-timeline-container" id="gantt-scroll" onscroll="syncScroll()">
                <div class="gantt-timeline" id="gantt-timeline"></div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         VIEW 3: RESOURCE WORKLOAD (DAILY HOURS ANALYTICS)
    ========================================================= -->
    <div id="view-resources" class="view-container view">
        <div class="panel animate-panel delay-1" style="margin-bottom: 14px;">
            <div class="panel-header">
                <span>RESOURCE DAILY WORKLOAD ANALYTICS <small style="color:var(--text-muted); font-size:0.74rem; margin-left:6px;">(末端タスクの作業時間を期間内の稼働日に日割り算出)</small></span>
                <div class="filter-bar">
                    <select id="resChartSelect" class="input-glow" onchange="renderResourceView()">
                        <option value="__ALL__">全リソース合計 / 比較</option>
                    </select>
                    <select id="resDayMode" class="input-glow" onchange="renderResourceView()">
                        <option value="weekdays" selected>配分: 営業日按分 (土日除く)</option>
                        <option value="all_days">配分: カレンダー全日程按分</option>
                    </select>
                    <label style="font-size:0.78rem; color:var(--text-main); display:flex; align-items:center; gap:6px; background:rgba(0,0,0,0.35); padding:3px 8px; border-radius:4px; border:1px solid rgba(255,42,95,0.35);">
                        <span style="color:#ff80a0;">過負荷ライン:</span>
                        <input type="number" id="resOverloadLimit" class="input-glow" value="8" min="0.5" max="24" step="0.5"
                               style="width:68px; text-align:right; padding:3px 6px;"
                               oninput="onOverloadLimitChange()" onchange="onOverloadLimitChange()">
                        <span style="color:var(--text-muted);">h/日</span>
                    </label>
                </div>
            </div>
            <div class="res-summary-cards" id="resSummaryCards"></div>
            <div class="res-chart-scroll" id="resDailyBarSvgContainer"></div>
        </div>

        <div class="panel animate-panel delay-2" style="flex:1; min-height: 220px;">
            <div class="panel-header">
                <span>DAILY WORKLOAD HEATMAP MATRIX (時間 / 日) <small style="color:var(--text-muted); font-size:0.74rem; margin-left:6px;">(セルクリックで円グラフ＆タスク内訳を表示)</small></span>
                <div class="gantt-legend">
                    <span><i class="legend-dot" style="background:rgba(0,243,255,0.25);"></i>低負荷</span>
                    <span><i class="legend-dot" style="background:rgba(0,243,255,0.5);"></i>適正</span>
                    <span><i class="legend-dot" style="background:rgba(255,170,0,0.55);"></i>高負荷</span>
                    <span><i class="legend-dot" style="background:rgba(255,42,95,0.7);"></i>基準超過</span>
                </div>
            </div>

            <!-- GRAPHICAL DAY BREAKDOWN PANEL (PIE CHART + TASK LIST) -->
            <div id="resCellDetailPanel" class="day-breakdown-panel"></div>

            <div class="table-container" id="resHeatmapContainer"></div>
        </div>
    </div>

    <!-- =========================================================
         GRAPHICAL TASK DETAIL HUD DRAWER
    ========================================================= -->
    <div class="drawer-backdrop" id="drawerBackdrop" onclick="closeTaskDetail()"></div>
    <aside class="task-drawer" id="taskDrawer">
        <div class="drawer-header">
            <div style="flex:1; min-width:0;">
                <div class="drawer-breadcrumbs" id="drawerBreadcrumbs"></div>
                <div class="drawer-title-row">
                    <span class="drawer-id-tag" id="drawerTaskId">ID: -</span>
                    <span id="drawerAlertBadge"></span>
                </div>
                <div class="drawer-task-name" id="drawerTaskName" style="margin-top:6px;">タスクを選択してください</div>
            </div>
            <button class="drawer-close-btn" onclick="closeTaskDetail()" title="閉じる (ESC)">✕</button>
        </div>
        <div class="drawer-body" id="drawerBody"></div>
    </aside>

    <script>
        let tasks = __WBS_JSON_DATA__;
        let collapsedNodes = new Set();
        let isFiltering = false;
        let showDepLines = true;
        let selectedTaskId = null;
        let selectedHeatmapCell = null; // { resName, dateKey }

        const PIE_PALETTE = [
            '#00f3ff',
            '#bc13fe',
            '#00ff66',
            '#ffaa00',
            '#ff2a5f',
            '#38bdf8',
            '#f472b6',
            '#a3e635'
        ];

        // 今日の日付（00:00:00基準）
        const now = new Date();
        const todayDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const todayStr = `${todayDate.getFullYear()}-${String(todayDate.getMonth() + 1).padStart(2, '0')}-${String(todayDate.getDate()).padStart(2, '0')}`;

        function parseLocalDate(isoStr) {
            if (!isoStr) return null;
            const parts = isoStr.split('-');
            if (parts.length !== 3) return null;
            return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
        }

        function formatDateKey(d) {
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        }

        function getDayOfWeekJa(isoStr) {
            const d = parseLocalDate(isoStr);
            if (!d) return '';
            return ['日', '月', '火', '水', '木', '金', '土'][d.getDay()];
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function togglePanel(panelId) {
            const panel = document.getElementById(panelId);
            if (panel) panel.classList.toggle('collapsed');
        }

        function triggerPrint() {
            const ts = new Date();
            const tsStr = `${ts.getFullYear()}-${String(ts.getMonth() + 1).padStart(2, '0')}-${String(ts.getDate()).padStart(2, '0')} ${String(ts.getHours()).padStart(2, '0')}:${String(ts.getMinutes()).padStart(2, '0')}`;
            document.getElementById('printTimestamp').textContent = `PRINTED: ${tsStr}`;
            window.print();
        }

        function replayViewAnimations(viewEl) {
            if (!viewEl) return;
            const animatedEls = viewEl.querySelectorAll('.animate-panel');
            animatedEls.forEach(el => {
                el.style.animation = 'none';
                void el.offsetWidth;
                el.style.animation = '';
            });
        }

        function initData() {
            document.getElementById('todayDisplay').textContent = `TODAY: ${todayStr}`;

            // PHASE PROGRESS: Level 1タスクの進捗を配下タスクの平均から自動計算
            const topLvlStats = {};
            tasks.forEach(t => {
                if (t.level === 1) topLvlStats[t.id] = { sum: 0, count: 0 };
            });

            tasks.forEach(t => {
                if (t.level > 1 && t.top_parent_id && topLvlStats[t.top_parent_id]) {
                    topLvlStats[t.top_parent_id].sum += parseFloat(t.progress || 0);
                    topLvlStats[t.top_parent_id].count++;
                }
            });

            tasks.forEach(t => {
                if (t.level === 1 && topLvlStats[t.id].count > 0) {
                    t.progress = topLvlStats[t.id].sum / topLvlStats[t.id].count;
                }
            });

            // リソースフィルター選択肢
            const resources = [...new Set(tasks.map(t => t.resource).filter(r => r))];
            const resSelect = document.getElementById('resourceFilter');
            const resChartSelect = document.getElementById('resChartSelect');
            resources.forEach(r => {
                const opt = document.createElement('option');
                opt.value = r;
                opt.textContent = r;
                resSelect.appendChild(opt);

                const opt2 = document.createElement('option');
                opt2.value = r;
                opt2.textContent = r;
                resChartSelect.appendChild(opt2);
            });
        }

        function getAlertInfo(t) {
            if (parseFloat(t.progress || 0) >= 0.999) return null;

            const threshold = parseInt(document.getElementById('alertThreshold').value, 10);
            const basis = document.getElementById('alertDateBasis').value;

            let targetStr = '';
            let basisLabel = '';
            if (basis === 'deadline_only') {
                targetStr = t.deadline;
                basisLabel = '期限';
            } else {
                if (t.deadline) {
                    targetStr = t.deadline;
                    basisLabel = '期限';
                } else if (t.end) {
                    targetStr = t.end;
                    basisLabel = '終了日';
                }
            }

            const targetDate = parseLocalDate(targetStr);
            if (!targetDate) return null;

            const diffDays = Math.round((targetDate - todayDate) / (1000 * 60 * 60 * 24));
            if (diffDays < 0) {
                return { type: 'overdue', diffDays, targetStr, basisLabel, label: `${Math.abs(diffDays)}日超過` };
            } else if (diffDays <= threshold) {
                const dayText = diffDays === 0 ? '本日期限' : `あと${diffDays}日`;
                return { type: 'soon', diffDays, targetStr, basisLabel, label: dayText };
            }
            return null;
        }

        function renderAlerts() {
            const container = document.getElementById('alertListContainer');
            const summaryContainer = document.getElementById('alertSummaryBadges');

            const alerted = [];
            tasks.forEach(t => {
                const info = getAlertInfo(t);
                if (info) alerted.push({ task: t, info });
            });

            alerted.sort((a, b) => a.info.diffDays - b.info.diffDays);

            const overdueCount = alerted.filter(a => a.info.type === 'overdue').length;
            const soonCount = alerted.filter(a => a.info.type === 'soon').length;

            if (alerted.length === 0) {
                summaryContainer.innerHTML = `<span class="alert-count-badge badge-ok">ALERT: 0件 (問題なし)</span>`;
                container.innerHTML = `<div style="font-size:0.82rem; color:var(--text-muted); padding:4px 0;">現在、期限超過または指定日数以内に期限を迎える未完了タスクはありません。</div>`;
                return;
            }

            summaryContainer.innerHTML = `
                <span class="alert-count-badge badge-overdue">期限超過: ${overdueCount}件</span>
                <span class="alert-count-badge badge-soon">期限間近: ${soonCount}件</span>
            `;

            let html = '';
            alerted.forEach(({ task, info }) => {
                const isOverdue = info.type === 'overdue';
                const cardClass = isOverdue ? 'alert-card overdue' : 'alert-card';
                const statusColor = isOverdue ? 'var(--neon-red)' : 'var(--neon-amber)';
                const prog = (parseFloat(task.progress || 0) * 100).toFixed(0);

                html += `
                    <div class="${cardClass}" onclick="openTaskDetail('${task.id}')">
                        <div class="alert-card-top">
                            <span style="color:var(--text-muted);">ID: ${escapeHtml(task.id)}</span>
                            <span style="color:${statusColor}; font-weight:bold;">[${info.label}]</span>
                        </div>
                        <div class="alert-card-name" title="${escapeHtml(task.name)}">${escapeHtml(task.name)}</div>
                        <div class="alert-card-meta">
                            <span>${info.basisLabel}: ${info.targetStr}</span>
                            <span>進捗: ${prog}%</span>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        function refreshAlertsAndTable() {
            renderAlerts();
            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {
                renderGantt();
            }
            if (selectedTaskId) {
                openTaskDetail(selectedTaskId, false);
            }
        }

        function switchTab(viewId, btnEl) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));

            btnEl.classList.add('active');
            const targetView = document.getElementById('view-' + viewId);
            targetView.classList.add('active');
            replayViewAnimations(targetView);

            if (viewId === 'dashboard') {
                renderDashboard();
            } else if (viewId === 'calendar') {
                renderGantt();
            } else if (viewId === 'resources') {
                renderResourceView();
            }
        }

        function toggleCollapse(id, e) {
            if (e) e.stopPropagation();
            if (isFiltering && document.getElementById('view-dashboard').classList.contains('active')) return;
            if (collapsedNodes.has(id)) collapsedNodes.delete(id);
            else collapsedNodes.add(id);

            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {
                renderGantt();
            }
        }

        function expandAll() {
            collapsedNodes.clear();
            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {
                renderGantt();
            }
        }

        function collapseAll() {
            tasks.forEach(t => {
                if (t.has_children) collapsedNodes.add(t.id);
            });
            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {
                renderGantt();
            }
        }

        function toggleDepLines() {
            showDepLines = !showDepLines;
            const btn = document.getElementById('toggleDepBtn');
            btn.textContent = `依存関係線: ${showDepLines ? 'ON' : 'OFF'}`;
            btn.classList.toggle('active', showDepLines);
            renderGantt();
        }

        function applyFilter() {
            const txt = document.getElementById('searchInput').value.toLowerCase();
            const res = document.getElementById('resourceFilter').value;
            const alertOnly = document.getElementById('alertOnlyCheck').checked;
            isFiltering = (txt !== '' || res !== '' || alertOnly);
            renderTable();
        }

        function isTaskHiddenByCollapse(t) {
            let curr = tasks.find(x => x.id === t.parent_id);
            while (curr) {
                if (collapsedNodes.has(curr.id)) return true;
                curr = tasks.find(x => x.id === curr.parent_id);
            }
            return false;
        }

        function renderDashboard() {
            const lvl1Tasks = tasks.filter(t => t.level === 1);
            const avgProgress = lvl1Tasks.length
                ? (lvl1Tasks.reduce((s, t) => s + parseFloat(t.progress || 0), 0) / lvl1Tasks.length) * 100
                : 0;

            const radius = 56;
            const circumference = 2 * Math.PI * radius;
            const targetOffset = circumference - (avgProgress / 100) * circumference;

            document.getElementById('pie-chart-container').innerHTML = `
                <svg width="146" height="146" viewBox="0 0 140 140">
                    <circle cx="70" cy="70" r="${radius}" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="12" />
                    <circle id="totalPieArc" cx="70" cy="70" r="${radius}" fill="none" stroke="#00f3ff" stroke-width="12"
                            stroke-dasharray="${circumference}" stroke-dashoffset="${circumference}"
                            stroke-linecap="round" transform="rotate(-90 70 70)"
                            style="filter: drop-shadow(0 0 8px #00f3ff); transition: stroke-dashoffset 1.2s cubic-bezier(0.16, 1, 0.3, 1);" />
                    <text id="totalPieText" x="70" y="77" text-anchor="middle" fill="#e2e8f0" font-size="22" font-family="monospace" font-weight="bold">0.0%</text>
                </svg>
            `;

            let html = '';
            lvl1Tasks.forEach((t, idx) => {
                const p = (parseFloat(t.progress || 0) * 100).toFixed(0);
                html += `
                    <div class="bar-item" onclick="openTaskDetail('${t.id}')">
                        <div class="bar-label" title="${escapeHtml(t.name)}">${escapeHtml(t.name)}</div>
                        <div class="bar-track">
                            <div class="bar-fill" id="phaseBar-${idx}" data-target="${p}" style="width: 0%"></div>
                        </div>
                        <div class="bar-percent" id="phasePct-${idx}" data-target="${p}">0%</div>
                    </div>`;
            });
            document.getElementById('bar-chart-container').innerHTML = html;

            requestAnimationFrame(() => {
                setTimeout(() => {
                    const arc = document.getElementById('totalPieArc');
                    if (arc) arc.style.strokeDashoffset = targetOffset;

                    animateNumber('totalPieText', 0, avgProgress, 1000, 1, '%');

                    lvl1Tasks.forEach((t, idx) => {
                        const p = parseFloat((parseFloat(t.progress || 0) * 100).toFixed(0));
                        const bar = document.getElementById(`phaseBar-${idx}`);
                        if (bar) bar.style.width = `${p}%`;
                        animateNumber(`phasePct-${idx}`, 0, p, 1000, 0, '%');
                    });
                }, 100);
            });
        }

        function animateNumber(elementId, startVal, endVal, durationMs, decimals, suffix) {
            const el = document.getElementById(elementId);
            if (!el) return;
            const startTime = performance.now();
            function tick(nowTime) {
                const elapsed = nowTime - startTime;
                const progress = Math.min(1, elapsed / durationMs);
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = startVal + (endVal - startVal) * eased;
                el.textContent = `${current.toFixed(decimals)}${suffix}`;
                if (progress < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        }

        function renderTable() {
            const tbody = document.querySelector('#wbs-table tbody');
            const txt = document.getElementById('searchInput').value.toLowerCase();
            const res = document.getElementById('resourceFilter').value;
            const alertOnly = document.getElementById('alertOnlyCheck').checked;

            let visibleSet = new Set();
            if (isFiltering) {
                tasks.forEach(t => {
                    let match = true;
                    if (txt && !t.name.toLowerCase().includes(txt) && !String(t.id).includes(txt)) match = false;
                    if (res && t.resource !== res) match = false;
                    if (alertOnly && !getAlertInfo(t)) match = false;

                    if (match) {
                        visibleSet.add(t.id);
                        let curr = tasks.find(x => x.id === t.parent_id);
                        while (curr) {
                            visibleSet.add(curr.id);
                            curr = tasks.find(x => x.id === curr.parent_id);
                        }
                    }
                });
            }

            let html = '';
            tasks.forEach(t => {
                if (isFiltering) {
                    if (!visibleSet.has(t.id)) return;
                } else {
                    if (isTaskHiddenByCollapse(t)) return;
                }

                const pad = (t.level - 1) * 18;
                const prog = (parseFloat(t.progress || 0) * 100).toFixed(0);
                const alertInfo = getAlertInfo(t);

                let rowClasses = [];
                if (t.level === 1) rowClasses.push('lvl-1');
                if (alertInfo) rowClasses.push(alertInfo.type === 'overdue' ? 'row-overdue' : 'row-soon');
                if (selectedTaskId === t.id) rowClasses.push('selected-row');

                let toggleIcon = '<span style="display:inline-block; width:22px;"></span>';
                if (t.has_children) {
                    const icon = collapsedNodes.has(t.id) ? '+' : '-';
                    toggleIcon = `<span class="toggle-btn" onclick="toggleCollapse('${t.id}', event)">[${icon}]</span>`;
                }

                let alertPill = '';
                if (alertInfo) {
                    const pillClass = alertInfo.type === 'overdue' ? 'pill-overdue' : 'pill-soon';
                    alertPill = `<span class="status-pill ${pillClass}">${alertInfo.label}</span>`;
                }

                const predText = t.predecessors.length ? `先:${t.predecessors.join(',')}` : '';
                const succText = t.successors.length ? `後:${t.successors.join(',')}` : '';
                const depDisplay = [predText, succText].filter(Boolean).join(' / ') || '-';

                html += `
                    <tr id="task-row-${t.id}" class="${rowClasses.join(' ')}" onclick="openTaskDetail('${t.id}')">
                        <td style="color: var(--text-muted); font-family:monospace;">${escapeHtml(t.id)}</td>
                        <td style="padding-left: ${pad + 8}px;">
                            ${toggleIcon}
                            ${escapeHtml(t.name)}
                            ${alertPill}
                        </td>
                        <td>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <div style="width:55px; background:rgba(255,255,255,0.1); height:6px; border-radius:3px;">
                                    <div style="height:100%; width:${prog}%; background:var(--neon-green); box-shadow:0 0 5px var(--neon-green); border-radius:3px;"></div>
                                </div>
                                <span style="font-family:monospace; font-size:0.8rem;">${prog}%</span>
                            </div>
                        </td>
                        <td style="font-size:0.8rem; color:var(--text-muted);">${escapeHtml(t.duration) || '-'} / ${escapeHtml(t.work_hours) || '-'}</td>
                        <td style="font-family:monospace;">${t.start || '-'}</td>
                        <td style="font-family:monospace;">${t.end || '-'}</td>
                        <td style="font-family:monospace; color:${t.deadline ? 'var(--text-main)' : 'var(--text-muted)'};">${t.deadline || 'N/A'}</td>
                        <td>${escapeHtml(t.resource) || '-'}</td>
                        <td style="font-size:0.78rem; color:var(--text-muted); font-family:monospace;">${escapeHtml(depDisplay)}</td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        /* =========================================================
           GRAPHICAL TASK DETAIL HUD & FULL-CHAIN DEPENDENCY GRAPH
        ========================================================= */
        function openTaskDetail(taskId, scrollToRow = true) {
            const task = tasks.find(t => String(t.id) === String(taskId));
            if (!task) return;

            selectedTaskId = task.id;

            let pCursor = tasks.find(x => x.id === task.parent_id);
            while (pCursor) {
                collapsedNodes.delete(pCursor.id);
                pCursor = tasks.find(x => x.id === pCursor.parent_id);
            }
            renderTable();

            if (scrollToRow) {
                const rowEl = document.getElementById(`task-row-${task.id}`);
                if (rowEl) rowEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            const ancestors = [];
            let curr = tasks.find(x => x.id === task.parent_id);
            while (curr) {
                ancestors.unshift(curr);
                curr = tasks.find(x => x.id === curr.parent_id);
            }
            const crumbHtml = ancestors.length
                ? ancestors.map(a => `<span class="crumb-link" onclick="openTaskDetail('${a.id}')">[${escapeHtml(a.id)}] ${escapeHtml(a.name)}</span>`).join(' <span>/</span> ')
                : '<span>ROOT LEVEL (Outline 1)</span>';
            document.getElementById('drawerBreadcrumbs').innerHTML = crumbHtml;

            document.getElementById('drawerTaskId').textContent = `ID: ${task.id} | LVL: ${task.level}`;
            document.getElementById('drawerTaskName').textContent = task.name;

            const alertInfo = getAlertInfo(task);
            const progFloat = parseFloat(task.progress || 0);
            const progPct = (progFloat * 100).toFixed(0);

            let statusBadgeHtml = '';
            if (progFloat >= 0.999) {
                statusBadgeHtml = `<span class="alert-count-badge badge-ok">COMPLETED (100%)</span>`;
            } else if (alertInfo) {
                const cls = alertInfo.type === 'overdue' ? 'badge-overdue' : 'badge-soon';
                statusBadgeHtml = `<span class="alert-count-badge ${cls}">${alertInfo.label}</span>`;
            } else {
                statusBadgeHtml = `<span class="alert-count-badge" style="border:1px solid var(--neon-blue); color:var(--neon-blue); background:rgba(0,243,255,0.1);">IN PROGRESS</span>`;
            }
            document.getElementById('drawerAlertBadge').innerHTML = statusBadgeHtml;

            let elapsedPct = 0;
            let scheduleNote = '日程データ不足';
            const sDate = parseLocalDate(task.start);
            const eDate = parseLocalDate(task.end);
            if (sDate && eDate) {
                const totalSpan = Math.max(1, (eDate - sDate) / (1000 * 60 * 60 * 24));
                const elapsedSpan = (todayDate - sDate) / (1000 * 60 * 60 * 24);
                elapsedPct = Math.max(0, Math.min(100, (elapsedSpan / totalSpan) * 100));
                if (todayDate < sDate) {
                    const untilStart = Math.round((sDate - todayDate) / (1000 * 60 * 60 * 24));
                    scheduleNote = `開始まであと ${untilStart}日`;
                } else if (todayDate > eDate) {
                    const pastEnd = Math.round((todayDate - eDate) / (1000 * 60 * 60 * 24));
                    scheduleNote = `終了予定日から ${pastEnd}日経過`;
                } else {
                    scheduleNote = `期間内の ${elapsedPct.toFixed(0)}% 経過`;
