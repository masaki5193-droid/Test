        function buildFullChainDependencySvg(currentTask) {
            const taskMap = {};
            const predsMap = {};
            const succsMap = {};

            tasks.forEach(t => {
                taskMap[t.id] = t;
                predsMap[t.id] = new Set();
                succsMap[t.id] = new Set();
            });

            tasks.forEach(t => {
                (t.predecessors || []).forEach(pid => {
                    if (!predsMap[t.id]) predsMap[t.id] = new Set();
                    if (!succsMap[pid]) succsMap[pid] = new Set();
                    predsMap[t.id].add(pid);
                    succsMap[pid].add(t.id);
                });
                (t.successors || []).forEach(sid => {
                    if (!succsMap[t.id]) succsMap[t.id] = new Set();
                    if (!predsMap[sid]) predsMap[sid] = new Set();
                    succsMap[t.id].add(sid);
                    predsMap[sid].add(t.id);
                });
            });

            const directPreds = predsMap[currentTask.id] || new Set();
            const directSuccs = succsMap[currentTask.id] || new Set();

            if (directPreds.size === 0 && directSuccs.size === 0) {
                return {
                    upCount: 0,
                    downCount: 0,
                    targetCenterX: null,
                    svgHtml: `<div style="padding:18px; text-align:center; color:var(--text-muted); font-size:0.8rem;">このタスクに紐づく先行タスク・後続タスクはありません。</div>`
                };
            }

            const layerMap = { [currentTask.id]: 0 };
            const upVisited = new Set([currentTask.id]);
            const upQueue = [{ id: currentTask.id, dist: 0 }];

            while (upQueue.length > 0) {
                const { id, dist } = upQueue.shift();
                const parents = predsMap[id] || new Set();
                parents.forEach(pid => {
                    const nextDist = dist - 1;
                    if (!upVisited.has(pid)) {
                        upVisited.add(pid);
                        layerMap[pid] = nextDist;
                        upQueue.push({ id: pid, dist: nextDist });
                    } else if (layerMap[pid] !== undefined && layerMap[pid] < 0 && nextDist < layerMap[pid] && upVisited.size < 200) {
                        if (nextDist >= -20) {
                            layerMap[pid] = nextDist;
                            upQueue.push({ id: pid, dist: nextDist });
                        }
                    }
                });
            }

            const downVisited = new Set([currentTask.id]);
            const downQueue = [{ id: currentTask.id, dist: 0 }];

            while (downQueue.length > 0) {
                const { id, dist } = downQueue.shift();
                const children = succsMap[id] || new Set();
                children.forEach(sid => {
                    const nextDist = dist + 1;
                    if (!downVisited.has(sid)) {
                        downVisited.add(sid);
                        if (layerMap[sid] === undefined) {
                            layerMap[sid] = nextDist;
                        }
                        downQueue.push({ id: sid, dist: nextDist });
                    } else if (layerMap[sid] !== undefined && layerMap[sid] > 0 && nextDist > layerMap[sid] && nextDist <= 20) {
                        layerMap[sid] = nextDist;
                        downQueue.push({ id: sid, dist: nextDist });
                    }
                });
            }

            const allChainIds = Object.keys(layerMap);
            const layers = [...new Set(Object.values(layerMap))].sort((a, b) => a - b);

            const nodesByLayer = {};
            layers.forEach(l => { nodesByLayer[l] = []; });
            allChainIds.forEach(id => {
                nodesByLayer[layerMap[id]].push(id);
            });

            const stdW = 148;
            const stdH = 44;
            const curW = 178;
            const curH = 58;
            const colGap = 46;
            const rowGap = 14;
            const padX = 16;
            const padY = 20;

            let maxNodesInCol = 1;
            layers.forEach(l => {
                if (nodesByLayer[l].length > maxNodesInCol) maxNodesInCol = nodesByLayer[l].length;
            });

            const svgH = Math.max(140, maxNodesInCol * (stdH + rowGap) + padY * 2 + 16);

            let currentX = padX;
            const colXMap = {};
            const colWidthMap = {};
            layers.forEach(l => {
                const w = (l === 0) ? curW : stdW;
                colXMap[l] = currentX;
                colWidthMap[l] = w;
                currentX += w + colGap;
            });
            const svgW = Math.max(520, currentX - colGap + padX);

            const nodeRects = {};
            layers.forEach(l => {
                const list = nodesByLayer[l];
                const w = colWidthMap[l];
                const h = (l === 0) ? curH : stdH;
                const totalColH = list.length * h + (list.length - 1) * rowGap;
                const startY = (svgH - totalColH) / 2;

                list.forEach((id, idx) => {
                    const nx = colXMap[l];
                    const ny = startY + idx * (h + rowGap);
                    nodeRects[id] = { x: nx, y: ny, w, h, layer: l };
                });
            });

            let pathsHtml = '';
            const drawnEdges = new Set();
            allChainIds.forEach(fromId => {
                const fromRect = nodeRects[fromId];
                const children = succsMap[fromId] || new Set();
                children.forEach(toId => {
                    const toRect = nodeRects[toId];
                    if (!fromRect || !toRect) return;
                    const edgeKey = `${fromId}->${toId}`;
                    if (drawnEdges.has(edgeKey)) return;
                    drawnEdges.add(edgeKey);

                    const isDirectToTarget = (fromId === currentTask.id || toId === currentTask.id);
                    const strokeCol = isDirectToTarget ? '#ff00ea' : '#00f3ff';
                    const strokeW = isDirectToTarget ? '2.2' : '1.3';
                    const strokeOp = isDirectToTarget ? '0.95' : '0.45';
                    const markerId = isDirectToTarget ? 'url(#chain-arrow-hot)' : 'url(#chain-arrow)';

                    const x1 = fromRect.x + fromRect.w;
                    const y1 = fromRect.y + fromRect.h / 2;
                    const x2 = toRect.x;
                    const y2 = toRect.y + toRect.h / 2;

                    let d = '';
                    if (x2 > x1) {
                        const cx = (x1 + x2) / 2;
                        d = `M ${x1} ${y1} C ${cx} ${y1}, ${cx} ${y2}, ${x2} ${y2}`;
                    } else {
                        const loopY = Math.min(y1, y2) - 24;
                        d = `M ${x1} ${y1} C ${x1 + 25} ${loopY}, ${x2 - 25} ${loopY}, ${x2} ${y2}`;
                    }

                    pathsHtml += `<path d="${d}" fill="none" stroke="${strokeCol}" stroke-width="${strokeW}" opacity="${strokeOp}" marker-end="${markerId}" />`;
                });
            });

            let nodesHtml = '';
            allChainIds.forEach(id => {
                const rect = nodeRects[id];
                const t = taskMap[id] || { id, name: `(外部/不明 ID:${id})`, progress: 0, missing: true };
                const pPct = (parseFloat(t.progress || 0) * 100).toFixed(0);
                const isTarget = (id === currentTask.id);

                if (isTarget) {
                    const curName = t.name.length > 15 ? t.name.slice(0, 15) + '…' : t.name;
                    nodesHtml += `
                        <g>
                            <rect class="current-node-pulse" x="${rect.x - 4}" y="${rect.y - 4}" width="${rect.w + 8}" height="${rect.h + 8}" rx="9"
                                  fill="none" stroke="#ff00ea" stroke-width="2.5" />
                            <rect x="${rect.x}" y="${rect.y}" width="${rect.w}" height="${rect.h}" rx="7"
                                  fill="url(#targetNodeGrad)" stroke="#00f3ff" stroke-width="2.5"
                                  style="filter: drop-shadow(0 0 10px rgba(0,243,255,0.65));" />
                            <rect x="${rect.x + 8}" y="${rect.y - 8}" width="106" height="15" rx="3" fill="#ff00ea" />
                            <text x="${rect.x + 61}" y="${rect.y + 3}" text-anchor="middle" fill="#ffffff" font-size="8.5" font-family="monospace" font-weight="bold">★ SELECTED TASK</text>
                            <text x="${rect.x + 10}" y="${rect.y + 23}" fill="#00f3ff" font-size="10" font-family="monospace" font-weight="bold">ID #${escapeHtml(t.id)} (${pPct}%)</text>
                            <text x="${rect.x + 10}" y="${rect.y + 42}" fill="#ffffff" font-size="11.5" font-weight="bold">${escapeHtml(curName)}</text>
                        </g>
                    `;
                } else {
                    const isUpstream = rect.layer < 0;
                    const strokeCol = t.missing ? '#64748b' : (isUpstream ? (parseFloat(t.progress || 0) >= 0.999 ? '#00ff66' : '#00f3ff') : '#ffaa00');
                    const tagPrefix = isUpstream ? `UP${rect.layer}` : `DN+${rect.layer}`;
                    const labelName = t.name.length > 13 ? t.name.slice(0, 13) + '…' : t.name;
                    const clickAttr = t.missing ? '' : `onclick="openTaskDetail('${t.id}')"`;

                    nodesHtml += `
                        <g class="dep-node-box" ${clickAttr}>
                            <rect x="${rect.x}" y="${rect.y}" width="${rect.w}" height="${rect.h}" rx="6"
                                  fill="rgba(10,20,45,0.95)" stroke="${strokeCol}" stroke-width="1.3" />
                            <text x="${rect.x + 8}" y="${rect.y + 16}" fill="${strokeCol}" font-size="9.2" font-family="monospace" font-weight="bold">[${tagPrefix}] #${escapeHtml(t.id)} (${pPct}%)</text>
                            <text x="${rect.x + 8}" y="${rect.y + 32}" fill="#e2e8f0" font-size="10.5">${escapeHtml(labelName)}</text>
                        </g>
                    `;
                }
            });

            const targetRect = nodeRects[currentTask.id];
            const targetCenterX = targetRect ? (targetRect.x + targetRect.w / 2) : null;

            return {
                upCount: upVisited.size - 1,
                downCount: downVisited.size - 1,
                targetCenterX,
                svgHtml: `
                    <svg width="${svgW}" height="${svgH}" viewBox="0 0 ${svgW} ${svgH}">
                        <defs>
                            <linearGradient id="targetNodeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="rgba(188, 19, 254, 0.45)" />
                                <stop offset="100%" stop-color="rgba(0, 243, 255, 0.25)" />
                            </linearGradient>
                            <marker id="chain-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
                                <path d="M 0 1 L 7 4 L 0 7 z" fill="#00f3ff" />
                            </marker>
                            <marker id="chain-arrow-hot" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                                <path d="M 0 1 L 7 4 L 0 7 z" fill="#ff00ea" />
                            </marker>
                        </defs>
                        ${pathsHtml}
                        ${nodesHtml}
                    </svg>
                `
            };
        }

        function closeTaskDetail() {
            document.getElementById('drawerBackdrop').classList.remove('open');
            document.getElementById('taskDrawer').classList.remove('open');
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeTaskDetail();
        });

        /* =========================================================
           VIEW 2: GANTT CALENDAR RENDERER
        ========================================================= */
        function renderGantt() {
            const labelsContainer = document.getElementById('gantt-labels');
            const timelineContainer = document.getElementById('gantt-timeline');

            const validTasks = tasks.filter(t => t.start && t.end);
            if (validTasks.length === 0) {
                labelsContainer.innerHTML = '<div style="padding:15px;">日付データがありません</div>';
                return;
            }

            const allTimes = validTasks.flatMap(t => [parseLocalDate(t.start).getTime(), parseLocalDate(t.end).getTime()]);
            allTimes.push(todayDate.getTime());

            const dayMs = 24 * 60 * 60 * 1000;
            const minDate = Math.min(...allTimes) - dayMs * 10;
            const maxDate = Math.max(...allTimes) + dayMs * 18;

            const totalDays = Math.ceil((maxDate - minDate) / dayMs);
            const dayWidth = parseInt(document.getElementById('ganttZoom').value, 10) || 5;
            const rowHeight = 34;

            let headerHtml = `<div class="g-header" style="width:${totalDays * dayWidth}px; height: 35px;">`;
            let currentMonth = '';
            let monthDays = 0;

            for (let i = 0; i < totalDays; i++) {
                const d = new Date(minDate + i * dayMs);
                const m = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
                if (m !== currentMonth) {
                    if (currentMonth !== '') {
                        headerHtml += `<div class="g-month" style="width:${monthDays * dayWidth}px">${currentMonth}</div>`;
                    }
                    currentMonth = m;
                    monthDays = 1;
                } else {
                    monthDays++;
                }
            }
            headerHtml += `<div class="g-month" style="width:${monthDays * dayWidth}px">${currentMonth}</div></div>`;

            const visibleTasks = tasks.filter(t => !isTaskHiddenByCollapse(t));

            let labelsHtml = `<div style="height:35px; border-bottom:1px solid rgba(0,243,255,0.25); background:rgba(10,18,38,0.98); display:flex; align-items:center; padding-left:12px; font-size:0.8rem; color:var(--neon-blue); letter-spacing:1px;">TASK HIERARCHY</div>`;
            let barsHtml = headerHtml;

            const todayX = ((todayDate.getTime() - minDate) / dayMs) * dayWidth;
            barsHtml += `<div class="g-today-line" style="left:${todayX}px;"><span class="g-today-label">TODAY</span></div>`;

            let yOffset = 35;
            const barPosMap = {};

            visibleTasks.forEach((t, rowIdx) => {
                const pad = (t.level - 1) * 15;
                const color = t.level === 1 ? 'var(--neon-blue)' : 'var(--text-main)';
                const fontWeight = t.level === 1 ? 'bold' : 'normal';

                let toggleIcon = '<span style="display:inline-block; width:20px; flex-shrink:0;"></span>';
                if (t.has_children) {
                    const icon = collapsedNodes.has(t.id) ? '+' : '-';
                    toggleIcon = `<span class="toggle-btn" style="flex-shrink:0;" onclick="toggleCollapse('${t.id}', event)">[${icon}]</span>`;
                }

                labelsHtml += `
                    <div class="g-row-label" onclick="openTaskDetail('${t.id}', false)" style="height:${rowHeight}px; padding-left:${pad + 8}px; color:${color}; font-weight:${fontWeight};" title="[${escapeHtml(t.id)}] ${escapeHtml(t.name)}">
                        ${toggleIcon}
                        <span style="overflow:hidden; text-overflow:ellipsis;">${escapeHtml(t.name)}</span>
                    </div>`;

                barsHtml += `<div class="g-row-bg" style="top:${yOffset}px; height:${rowHeight}px;"></div>`;

                if (t.start && t.end) {
                    const sTime = parseLocalDate(t.start).getTime();
                    const eTime = parseLocalDate(t.end).getTime();
                    const startX = ((sTime - minDate) / dayMs) * dayWidth;
                    const w = Math.max(((eTime - sTime) / dayMs) * dayWidth, 8);
                    const centerY = yOffset + rowHeight / 2;

                    barPosMap[t.id] = { startX, endX: startX + w, centerY };

                    const alertInfo = getAlertInfo(t);
                    let barColor = t.level === 1 ? '#bc13fe' : '#00f3ff';
                    let textColor = t.level === 1 ? '#ffffff' : '#030712';
                    let glowColor = barColor;

                    if (alertInfo) {
                        if (alertInfo.type === 'overdue') {
                            barColor = '#ff2a5f';
                            textColor = '#ffffff';
                            glowColor = '#ff2a5f';
                        } else {
                            barColor = '#ffaa00';
                            textColor = '#030712';
                            glowColor = '#ffaa00';
                        }
                    }

                    const prog = (parseFloat(t.progress || 0) * 100).toFixed(0);
                    const animDelay = Math.min(rowIdx * 16, 480);

                    barsHtml += `
                        <div class="g-bar"
                             data-task-id="${t.id}"
                             onclick="openTaskDetail('${t.id}', false)"
                             onmouseenter="highlightDeps('${t.id}')"
                             onmouseleave="clearDepHighlight()"
                             style="top:${yOffset + 8}px; left:${startX}px; width:${w}px; background:${barColor}; color:${textColor}; box-shadow: 0 0 8px ${glowColor}; animation-delay:${animDelay}ms;"
                             title="[ID:${escapeHtml(t.id)}] ${escapeHtml(t.name)} (${t.start} 〜 ${t.end} / 進捗:${prog}%)">
                            ${w > 28 ? prog + '%' : ''}
                        </div>`;
                }
                yOffset += rowHeight;
            });

            if (showDepLines) {
                const edgeSet = new Set();
                const edges = [];

                visibleTasks.forEach(t => {
                    (t.predecessors || []).forEach(predId => {
                        const key = `${predId}->${t.id}`;
                        if (!edgeSet.has(key)) {
                            edgeSet.add(key);
                            edges.push({ from: predId, to: t.id });
                        }
                    });
                    (t.successors || []).forEach(succId => {
                        const key = `${t.id}->${succId}`;
                        if (!edgeSet.has(key)) {
                            edgeSet.add(key);
                            edges.push({ from: t.id, to: succId });
                        }
                    });
                });

                let pathsHtml = '';
                edges.forEach(edge => {
                    const fromPos = barPosMap[edge.from];
                    const toPos = barPosMap[edge.to];
                    if (!fromPos || !toPos) return;

                    const x1 = fromPos.endX;
                    const y1 = fromPos.centerY;
                    const x2 = toPos.startX;
                    const y2 = toPos.centerY;
                    const gap = 10;

                    let d = '';
                    if (x2 >= x1 + gap) {
                        const midX = x1 + gap;
                        d = `M ${x1} ${y1} L ${midX} ${y1} L ${midX} ${y2} L ${x2} ${y2}`;
                    } else {
                        const outX = x1 + gap;
                        const inX = Math.max(0, x2 - gap);
                        const midY = y1 + (y2 > y1 ? rowHeight / 2 : -rowHeight / 2);
                        d = `M ${x1} ${y1} L ${outX} ${y1} L ${outX} ${midY} L ${inX} ${midY} L ${inX} ${y2} L ${x2} ${y2}`;
                    }

                    pathsHtml += `<path class="dep-path" data-from="${edge.from}" data-to="${edge.to}" d="${d}" marker-end="url(#dep-arrow)" />`;
                });

                const totalWidth = totalDays * dayWidth;
                barsHtml += `
                    <svg class="dep-svg" width="${totalWidth}" height="${yOffset}">
                        <defs>
                            <marker id="dep-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                                <path d="M 0 1 L 7 4 L 0 7 z" fill="#00f3ff" />
                            </marker>
                        </defs>
                        ${pathsHtml}
                    </svg>`;
            }

            labelsContainer.innerHTML = labelsHtml;
            timelineContainer.innerHTML = barsHtml;
            timelineContainer.style.width = (totalDays * dayWidth) + 'px';
            timelineContainer.style.height = yOffset + 'px';
        }

        function highlightDeps(taskId) {
            const paths = document.querySelectorAll('.dep-path');
            if (!paths.length) return;
            paths.forEach(p => {
                if (p.dataset.from === taskId || p.dataset.to === taskId) {
                    p.classList.add('highlighted');
                    p.classList.remove('dimmed');
                } else {
                    p.classList.add('dimmed');
                    p.classList.remove('highlighted');
                }
            });
        }

        function clearDepHighlight() {
            document.querySelectorAll('.dep-path').forEach(p => {
                p.classList.remove('highlighted', 'dimmed');
            });
        }

        function syncScroll() {
            const timeline = document.getElementById('gantt-scroll');
            const labels = document.getElementById('gantt-labels');
            labels.scrollTop = timeline.scrollTop;
        }

        /* =========================================================
           VIEW 3: RESOURCE DAILY WORKLOAD ANALYTICS & GRAPHICAL BREAKDOWN
        ========================================================= */
        let currentWorkloadCache = null;

        function getOverloadLimit() {
            const el = document.getElementById('resOverloadLimit');
            const val = parseFloat(el ? el.value : '8');
            return (!isNaN(val) && val > 0) ? val : 8.0;
        }

        function onOverloadLimitChange() {
            renderResourceView();
            if (selectedHeatmapCell) {
                showResourceDayDetail(selectedHeatmapCell.resName, selectedHeatmapCell.dateKey, false);
            }
        }

        function computeResourceWorkload() {
            const dayMode = document.getElementById('resDayMode').value;
            const dayMs = 24 * 60 * 60 * 1000;

            const leafTasks = tasks.filter(t => !t.has_children && t.work_hours_num > 0 && t.start && t.end);

            if (leafTasks.length === 0) {
                return null;
            }

            let minTime = Infinity;
            let maxTime = -Infinity;
            leafTasks.forEach(t => {
                const s = parseLocalDate(t.start).getTime();
                const e = parseLocalDate(t.end).getTime();
                if (s < minTime) minTime = s;
                if (e > maxTime) maxTime = e;
            });

            const allDates = [];
            for (let tm = minTime; tm <= maxTime; tm += dayMs) {
                const d = new Date(tm);
                const dow = d.getDay();
                allDates.push({
                    key: formatDateKey(d),
                    date: d,
                    isWeekend: (dow === 0 || dow === 6),
                    shortLabel: `${d.getMonth() + 1}/${d.getDate()}`
                });
            }

            const resourceSet = new Set();
            leafTasks.forEach(t => {
                resourceSet.add(t.resource || '未割り当て');
            });
            const resourceList = [...resourceSet];

            const matrix = {};
            const resTotals = {};
            resourceList.forEach(r => {
                matrix[r] = {};
                resTotals[r] = { totalHours: 0, taskCount: 0, peakHours: 0 };
            });

            leafTasks.forEach(t => {
                const rName = t.resource || '未割り当て';
                resTotals[rName].totalHours += t.work_hours_num;
                resTotals[rName].taskCount += 1;

                const sDate = parseLocalDate(t.start);
                const eDate = parseLocalDate(t.end);
                const spanDates = [];
                for (let tm = sDate.getTime(); tm <= eDate.getTime(); tm += dayMs) {
                    const d = new Date(tm);
                    const dow = d.getDay();
                    if (dayMode === 'all_days' || (dow !== 0 && dow !== 6)) {
                        spanDates.push(formatDateKey(d));
                    }
                }
                if (spanDates.length === 0) {
                    for (let tm = sDate.getTime(); tm <= eDate.getTime(); tm += dayMs) {
                        spanDates.push(formatDateKey(new Date(tm)));
                    }
                }

                const perDay = t.work_hours_num / spanDates.length;
                spanDates.forEach(dk => {
                    if (!matrix[rName][dk]) matrix[rName][dk] = { hours: 0, entries: [] };
                    matrix[rName][dk].hours += perDay;
                    matrix[rName][dk].entries.push({ task: t, dailyHours: perDay });
                });
            });

            resourceList.forEach(r => {
                let peak = 0;
                Object.values(matrix[r]).forEach(cell => {
                    if (cell.hours > peak) peak = cell.hours;
                });
                resTotals[r].peakHours = peak;
            });

            return { allDates, resourceList, matrix, resTotals };
        }

        function renderResourceView() {
            const cardsEl = document.getElementById('resSummaryCards');
            const chartEl = document.getElementById('resDailyBarSvgContainer');
            const hmEl = document.getElementById('resHeatmapContainer');

            const data = computeResourceWorkload();
            currentWorkloadCache = data;

            if (!data) {
                cardsEl.innerHTML = `<div style="color:var(--text-muted); font-size:0.85rem;">作業時間（時間）および開始日・終了日が設定された末端タスクがありません。</div>`;
                chartEl.innerHTML = '';
                hmEl.innerHTML = '';
                return;
            }

            const { allDates, resourceList, matrix, resTotals } = data;
            const selectedRes = document.getElementById('resChartSelect').value;
            const overloadLimit = getOverloadLimit();

            const maxTotalHours = Math.max(1, ...resourceList.map(r => resTotals[r].totalHours));

            // 1. リソース別サマリーカード
            let cardsHtml = `
                <div class="res-card ${selectedRes === '__ALL__' ? 'active-res' : ''}" style="animation-delay:0ms;" onclick="selectWorkloadResource('__ALL__')">
                    <div class="res-card-name">ALL RESOURCES (全体)</div>
                    <div class="res-card-stats">
                        <span>計 ${resourceList.length} 名/組</span>
                        <span>${resourceList.reduce((s, r) => s + resTotals[r].totalHours, 0).toFixed(0)}h</span>
                    </div>
                    <div class="res-card-bar"><div class="res-card-fill" style="width:100%;"></div></div>
                </div>
            `;

            resourceList.forEach((r, idx) => {
                const st = resTotals[r];
                const barW = (st.totalHours / maxTotalHours) * 100;
                const peakColor = st.peakHours > overloadLimit ? 'var(--neon-red)' : 'var(--neon-green)';
                const delay = Math.min((idx + 1) * 50, 400);
                cardsHtml += `
                    <div class="res-card ${selectedRes === r ? 'active-res' : ''}" style="animation-delay:${delay}ms;" onclick="selectWorkloadResource('${escapeHtml(r)}')">
                        <div class="res-card-name" title="${escapeHtml(r)}">${escapeHtml(r)}</div>
                        <div class="res-card-stats">
                            <span>計 ${st.totalHours.toFixed(1)}h (${st.taskCount}件)</span>
                            <span style="color:${peakColor};">最大 ${st.peakHours.toFixed(1)}h/日</span>
                        </div>
                        <div class="res-card-bar"><div class="res-card-fill" style="width:${barW}%;"></div></div>
                    </div>
                `;
            });
            cardsEl.innerHTML = cardsHtml;

            // 2. 日別作業時間SVG棒グラフ
            const colW = 24;
            const chartH = 210;
            const padL = 42;
            const padB = 34;
            const padT = 18;
            const plotH = chartH - padT - padB;
            const svgW = Math.max(640, padL + allDates.length * colW + 20);

            const dailySeries = allDates.map(dObj => {
                let hrs = 0;
                if (selectedRes === '__ALL__') {
                    resourceList.forEach(r => {
                        hrs += (matrix[r][dObj.key]?.hours || 0);
                    });
                } else {
                    hrs = matrix[selectedRes]?.[dObj.key]?.hours || 0;
                }
                return { ...dObj, hours: hrs };
            });

            const maxDaily = Math.max(overloadLimit * 1.25, ...dailySeries.map(d => d.hours), 1);
            const limitY = padT + plotH - (overloadLimit / maxDaily) * plotH;

            let barsSvg = '';
            dailySeries.forEach((d, idx) => {
                const x = padL + idx * colW + 3;
                const bw = colW - 6;
                const bh = (d.hours / maxDaily) * plotH;
                const y = padT + plotH - bh;

                const isOver = (selectedRes !== '__ALL__' && d.hours > overloadLimit) || (selectedRes === '__ALL__' && d.hours > overloadLimit * resourceList.length);
                const fillCol = isOver ? '#ff2a5f' : (d.hours > overloadLimit * 0.75 ? '#ffaa00' : '#00f3ff');
                const barDelay = Math.min(idx * 10, 450);

                if (d.hours > 0) {
                    barsSvg += `
                        <rect class="res-bar-rect" x="${x}" y="${y}" width="${bw}" height="${bh}" rx="2" fill="${fillCol}" opacity="0.88" style="animation-delay:${barDelay}ms;">
                            <title>${d.key}: ${d.hours.toFixed(2)} 時間</title>
                        </rect>
                    `;
                    if (d.hours >= 1) {
                        barsSvg += `<text x="${x + bw / 2}" y="${Math.max(11, y - 3)}" text-anchor="middle" fill="#cbd5e1" font-size="8" font-family="monospace">${d.hours.toFixed(0)}</text>`;
                    }
                }

                if (idx % 3 === 0 || d.key === todayStr) {
                    const lblCol = d.key === todayStr ? '#00ff66' : '#64748b';
                    barsSvg += `<text x="${x + bw / 2}" y="${chartH - 12}" text-anchor="middle" fill="${lblCol}" font-size="8.5" font-family="monospace">${d.shortLabel}</text>`;
                }
                if (d.key === todayStr) {
                    barsSvg += `<line x1="${x + bw / 2}" y1="${padT}" x2="${x + bw / 2}" y2="${padT + plotH}" stroke="#00ff66" stroke-width="1.5" stroke-dasharray="3,2" />`;
                }
            });

            let limitLineSvg = '';
            if (selectedRes !== '__ALL__') {
                limitLineSvg = `
                    <line x1="${padL}" y1="${limitY}" x2="${svgW - 10}" y2="${limitY}" stroke="#ff2a5f" stroke-width="1.4" stroke-dasharray="5,4" />
                    <text x="${padL + 6}" y="${Math.max(12, limitY - 4)}" fill="#ff2a5f" font-size="9.5" font-family="monospace" font-weight="bold">OVERLOAD LIMIT: ${overloadLimit}h/日</text>
                `;
            }

            chartEl.innerHTML = `
                <svg width="${svgW}" height="${chartH}" viewBox="0 0 ${svgW} ${chartH}">
                    <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT + plotH}" stroke="rgba(255,255,255,0.2)" />
                    <line x1="${padL}" y1="${padT + plotH}" x2="${svgW - 10}" y2="${padT + plotH}" stroke="rgba(255,255,255,0.2)" />
                    <text x="${padL - 6}" y="${padT + 6}" text-anchor="end" fill="#64748b" font-size="9" font-family="monospace">${maxDaily.toFixed(0)}h</text>
                    <text x="${padL - 6}" y="${padT + plotH / 2}" text-anchor="end" fill="#64748b" font-size="9" font-family="monospace">${(maxDaily / 2).toFixed(0)}h</text>
                    <text x="${padL - 6}" y="${padT + plotH}" text-anchor="end" fill="#64748b" font-size="9" font-family="monospace">0h</text>
                    ${barsSvg}
                    ${limitLineSvg}
                </svg>
            `;

            // 3. リソース × 日付 ヒートマップマトリクス
            const targetResources = selectedRes === '__ALL__' ? resourceList : [selectedRes];
            let thHtml = `<tr><th class="sticky-res">リソース / 日付</th>`;
            allDates.forEach(d => {
                const isToday = d.key === todayStr;
                const style = isToday ? 'background:rgba(0,255,102,0.2); color:#00ff66;' : (d.isWeekend ? 'color:#64748b;' : '');
                thHtml += `<th style="${style}" title="${d.key}">${d.shortLabel}</th>`;
            });
            thHtml += `</tr>`;

            let tbHtml = '';
            targetResources.forEach(r => {
                tbHtml += `<tr><td class="sticky-res" title="${escapeHtml(r)}">${escapeHtml(r)}</td>`;
                allDates.forEach(d => {
                    const cell = matrix[r][d.key];
                    const hrs = cell ? cell.hours : 0;
                    let cls = 'hm-cell ';
                    if (hrs <= 0) cls += 'hm-0';
                    else if (hrs > overloadLimit) cls += 'hm-over';
                    else if (hrs > overloadLimit * 0.75) cls += 'hm-high';
                    else if (hrs > overloadLimit * 0.35) cls += 'hm-mid';
                    else cls += 'hm-low';

                    if (d.isWeekend) cls += ' hm-weekend';
                    if (selectedHeatmapCell && selectedHeatmapCell.resName === r && selectedHeatmapCell.dateKey === d.key) {
                        cls += ' hm-selected';
                    }

                    const disp = hrs > 0 ? hrs.toFixed(1) : '-';
                    const clickAttr = hrs > 0 ? `onclick="showResourceDayDetail('${escapeHtml(r)}', '${d.key}')"` : '';
                    tbHtml += `<td class="${cls}" ${clickAttr} title="${r} | ${d.key}: ${hrs.toFixed(2)}時間 (クリックで円グラフ詳細)">${disp}</td>`;
                });
                tbHtml += `</tr>`;
            });

            hmEl.innerHTML = `<table class="heatmap-table"><thead>${thHtml}</thead><tbody>${tbHtml}</tbody></table>`;
        }

        function selectWorkloadResource(resName) {
            document.getElementById('resChartSelect').value = resName;
            renderResourceView();
        }

        function showResourceDayDetail(resName, dateKey, reRenderMatrix = true) {
            const panel = document.getElementById('resCellDetailPanel');
            if (!currentWorkloadCache) return;
            const cell = currentWorkloadCache.matrix[resName]?.[dateKey];
            if (!cell || cell.hours <= 0) return;

            selectedHeatmapCell = { resName, dateKey };
            if (reRenderMatrix) {
                renderResourceView();
            }

            const overloadLimit = getOverloadLimit();
            const totalHrs = cell.hours;
            const loadPct = (totalHrs / overloadLimit) * 100;
            const isOver = totalHrs > overloadLimit;
            const statusCol = isOver ? 'var(--neon-red)' : (loadPct > 75 ? 'var(--neon-amber)' : 'var(--neon-green)');
            const statusLabel = isOver ? `OVERLOAD (+${(totalHrs - overloadLimit).toFixed(1)}h超過)` : `NORMAL (${loadPct.toFixed(0)}%)`;

            // 時間が多い順にソート
            const sortedEntries = [...cell.entries].sort((a, b) => b.dailyHours - a.dailyHours);

            // SVGドーナツ円グラフ生成
            const radius = 52;
            const circumference = 2 * Math.PI * radius;
            let cumulativeRatio = 0;
            let pieSegmentsSvg = '';

            sortedEntries.forEach((entry, idx) => {
                const color = PIE_PALETTE[idx % PIE_PALETTE.length];
                const ratio = entry.dailyHours / totalHrs;
                const segLen = ratio * circumference;
                const offset = -cumulativeRatio * circumference;
                cumulativeRatio += ratio;

                pieSegmentsSvg += `
                    <circle cx="70" cy="70" r="${radius}" fill="none" stroke="${color}" stroke-width="16"
                            stroke-dasharray="${segLen} ${circumference}"
                            stroke-dashoffset="${offset}"
                            transform="rotate(-90 70 70)"
                            style="filter: drop-shadow(0 0 4px ${color}); transition: stroke-dasharray 0.6s ease;">
                        <title>#${escapeHtml(entry.task.id)} ${escapeHtml(entry.task.name)}: ${entry.dailyHours.toFixed(2)}h (${(ratio * 100).toFixed(1)}%)</title>
                    </circle>
                `;
            });

            // タスク内訳一覧HTML
            const listHtml = sortedEntries.map((entry, idx) => {
                const color = PIE_PALETTE[idx % PIE_PALETTE.length];
                const sharePct = ((entry.dailyHours / totalHrs) * 100).toFixed(1);
                const taskProg = (parseFloat(entry.task.progress || 0) * 100).toFixed(0);
                return `
                    <div class="day-task-row" onclick="openTaskDetail('${entry.task.id}', false)" title="クリックでタスク詳細HUDを開く">
                        <div style="display:flex; align-items:center; gap:10px; min-width:0; flex:1;">
                            <span class="day-color-dot" style="background:${color}; box-shadow:0 0 6px ${color};"></span>
                            <div style="min-width:0; flex:1;">
                                <div style="font-size:0.84rem; font-weight:bold; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                    <span style="color:var(--text-muted); font-family:monospace; margin-right:6px;">#${escapeHtml(entry.task.id)}</span>
                                    <span>${escapeHtml(entry.task.name)}</span>
                                </div>
                                <div style="font-size:0.72rem; color:var(--text-muted); margin-top:2px;">
                                    期間: ${entry.task.start} 〜 ${entry.task.end} ｜ 総工数: ${escapeHtml(entry.task.work_hours) || '-'} ｜ タスク進捗: <span style="color:var(--neon-green);">${taskProg}%</span>
                                </div>
                            </div>
                        </div>
                        <div style="text-align:right; flex-shrink:0; font-family:monospace;">
                            <div style="font-size:0.9rem; font-weight:bold; color:${color};">${entry.dailyHours.toFixed(2)} h/日</div>
                            <div style="font-size:0.72rem; color:var(--text-muted);">シェア ${sharePct}%</div>
                        </div>
                    </div>
                `;
            }).join('');

            const dow = getDayOfWeekJa(dateKey);
            const meterWidth = Math.min(100, loadPct);

            panel.style.display = 'block';
            panel.innerHTML = `
                <div class="day-breakdown-header">
                    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                        <span style="font-family:monospace; font-size:0.76rem; padding:2px 8px; border-radius:4px; background:rgba(0,243,255,0.15); border:1px solid var(--neon-blue); color:var(--neon-blue);">DAILY WORKLOAD BREAKDOWN</span>
                        <strong style="font-size:0.98rem; color:#fff;">${escapeHtml(resName)}</strong>
                        <span style="font-family:monospace; color:var(--neon-purple); font-weight:bold;">${dateKey} (${dow})</span>
                        <span style="font-family:monospace; font-size:0.78rem; padding:2px 8px; border-radius:12px; border:1px solid ${statusCol}; color:${statusCol}; font-weight:bold;">${statusLabel}</span>
                    </div>
                    <button class="mini-btn" onclick="closeResourceDayDetail()">✕ 閉じる</button>
                </div>

                <div class="day-breakdown-grid">
                    <div class="day-pie-box">
                        <svg width="140" height="140" viewBox="0 0 140 140">
                            <circle cx="70" cy="70" r="${radius}" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="16" />
                            ${pieSegmentsSvg}
                            <text x="70" y="68" text-anchor="middle" fill="#ffffff" font-size="18" font-family="monospace" font-weight="bold">${totalHrs.toFixed(1)}h</text>
                            <text x="70" y="84" text-anchor="middle" fill="#94a3b8" font-size="9.5" font-family="monospace">${sortedEntries.length} TASKS</text>
                        </svg>
                        <div style="font-size:0.72rem; color:var(--text-muted); margin-top:4px; font-family:monospace;">基準上限: ${overloadLimit.toFixed(1)}h/日</div>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:10px; min-width:0;">
                        <div>
                            <div style="display:flex; justify-content:space-between; font-size:0.76rem; margin-bottom:4px; font-family:monospace;">
                                <span style="color:var(--text-muted);">日次稼働キャパシティ (${totalHrs.toFixed(2)}h / 基準 ${overloadLimit.toFixed(1)}h)</span>
                                <span style="color:${statusCol}; font-weight:bold;">${loadPct.toFixed(0)}%</span>
                            </div>
                            <div style="height:7px; background:rgba(255,255,255,0.08); border-radius:4px; overflow:hidden;">
                                <div style="height:100%; width:${meterWidth}%; background:${statusCol}; box-shadow:0 0 8px ${statusCol}; transition:width 0.5s ease;"></div>
                            </div>
                        </div>
                        <div class="day-task-list">
                            ${listHtml}
                        </div>
                    </div>
                </div>
            `;
        }

        function closeResourceDayDetail() {
            selectedHeatmapCell = null;
            document.getElementById('resCellDetailPanel').style.display = 'none';
            renderResourceView();
        }

        document.addEventListener('DOMContentLoaded', () => {
            initData();
            renderAlerts();
            renderDashboard();
            renderTable();
        });
    </script>
</body>
</html>"""

