                <span><i class="legend-dot" style="background:var(--neon-blue);"></i>通常タスク</span>
                <span><i class="legend-dot" style="background:var(--neon-amber);"></i>期限間近</span>
                <span><i class="legend-dot" style="background:var(--neon-red);"></i>期限超過</span>
                <span><i class="legend-dot" style="background:var(--neon-green);"></i>TODAY</span>
            </div>
        </div>
        <div class="gantt-wrapper">
            <div class="gantt-labels" id="gantt-labels"></div>
            <div class="gantt-timeline-container" id="gantt-scroll" onscroll="syncScroll()">
                <div class="gantt-timeline" id="gantt-timeline"></div>
            </div>
        </div>
    </div>

    <script>
        let tasks = {json_data};
        let collapsedNodes = new Set();
        let isFiltering = false;
        let showDepLines = true;

        // 今日の日付（00:00:00基準）
        const now = new Date();
        const todayDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const todayStr = `${{todayDate.getFullYear()}}-${{String(todayDate.getMonth() + 1).padStart(2, '0')}}-${{String(todayDate.getDate()).padStart(2, '0')}}`;

        function parseLocalDate(isoStr) {{
            if (!isoStr) return null;
            const parts = isoStr.split('-');
            if (parts.length !== 3) return null;
            return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
        }}

        function initData() {{
            document.getElementById('todayDisplay').textContent = `TODAY: ${{todayStr}}`;

            // PHASE PROGRESS: Level 1タスクの進捗を配下タスクの平均から自動計算
            const topLvlStats = {{}};
            tasks.forEach(t => {{
                if (t.level === 1) topLvlStats[t.id] = {{ sum: 0, count: 0 }};
            }});

            tasks.forEach(t => {{
                if (t.level > 1 && t.top_parent_id && topLvlStats[t.top_parent_id]) {{
                    topLvlStats[t.top_parent_id].sum += parseFloat(t.progress || 0);
                    topLvlStats[t.top_parent_id].count++;
                }}
            }});

            tasks.forEach(t => {{
                if (t.level === 1 && topLvlStats[t.id].count > 0) {{
                    t.progress = topLvlStats[t.id].sum / topLvlStats[t.id].count;
                }}
            }});

            // リソースフィルター選択肢
            const resources = [...new Set(tasks.map(t => t.resource).filter(r => r))];
            const resSelect = document.getElementById('resourceFilter');
            resources.forEach(r => {{
                const opt = document.createElement('option');
                opt.value = r;
                opt.textContent = r;
                resSelect.appendChild(opt);
            }});
        }}

        function getAlertInfo(t) {{
            // 完了済み（100%以上）はアラート対象外
            if (parseFloat(t.progress || 0) >= 0.999) return null;

            const threshold = parseInt(document.getElementById('alertThreshold').value, 10);
            const basis = document.getElementById('alertDateBasis').value;

            let targetStr = '';
            let basisLabel = '';
            if (basis === 'deadline_only') {{
                targetStr = t.deadline;
                basisLabel = '期限';
            }} else {{
                if (t.deadline) {{
                    targetStr = t.deadline;
                    basisLabel = '期限';
                }} else if (t.end) {{
                    targetStr = t.end;
                    basisLabel = '終了日';
                }}
            }}

            const targetDate = parseLocalDate(targetStr);
            if (!targetDate) return null;

            const diffDays = Math.round((targetDate - todayDate) / (1000 * 60 * 60 * 24));
            if (diffDays < 0) {{
                return {{ type: 'overdue', diffDays, targetStr, basisLabel, label: `${{Math.abs(diffDays)}}日超過` }};
            }} else if (diffDays <= threshold) {{
                const dayText = diffDays === 0 ? '本日期限' : `あと${{diffDays}}日`;
                return {{ type: 'soon', diffDays, targetStr, basisLabel, label: dayText }};
            }}
            return null;
        }}

        function renderAlerts() {{
            const container = document.getElementById('alertListContainer');
            const summaryContainer = document.getElementById('alertSummaryBadges');

            const alerted = [];
            tasks.forEach(t => {{
                const info = getAlertInfo(t);
                if (info) alerted.push({{ task: t, info }});
            }});

            // 超過日数が多い順・残り日数が少ない順にソート
            alerted.sort((a, b) => a.info.diffDays - b.info.diffDays);

            const overdueCount = alerted.filter(a => a.info.type === 'overdue').length;
            const soonCount = alerted.filter(a => a.info.type === 'soon').length;

            if (alerted.length === 0) {{
                summaryContainer.innerHTML = `<span class="alert-count-badge badge-ok">ALERT: 0件 (問題なし)</span>`;
                container.innerHTML = `<div style="font-size:0.82rem; color:var(--text-muted); padding:4px 0;">現在、期限超過または指定日数以内に期限を迎える未完了タスクはありません。</div>`;
                return;
            }}

            summaryContainer.innerHTML = `
                <span class="alert-count-badge badge-overdue">期限超過: ${{overdueCount}}件</span>
                <span class="alert-count-badge badge-soon">期限間近: ${{soonCount}}件</span>
            `;

            let html = '';
            alerted.forEach(({{ task, info }}) => {{
                const isOverdue = info.type === 'overdue';
                const cardClass = isOverdue ? 'alert-card overdue' : 'alert-card';
                const statusColor = isOverdue ? 'var(--neon-red)' : 'var(--neon-amber)';
                const prog = (parseFloat(task.progress || 0) * 100).toFixed(0);

                html += `
                    <div class="${{cardClass}}" onclick="jumpToTask('${{task.id}}')">
                        <div class="alert-card-top">
                            <span style="color:var(--text-muted);">ID: ${{task.id}}</span>
                            <span style="color:${{statusColor}}; font-weight:bold;">[${{info.label}}]</span>
                        </div>
                        <div class="alert-card-name" title="${{task.name}}">${{task.name}}</div>
                        <div class="alert-card-meta">
                            <span>${{info.basisLabel}}: ${{info.targetStr}}</span>
                            <span>進捗: ${{prog}}%</span>
                        </div>
                    </div>
                `;
            }});
            container.innerHTML = html;
        }}

        function jumpToTask(taskId) {{
            // 親階層を展開して該当行へスクロール
            let curr = tasks.find(x => x.id === taskId);
            while (curr && curr.parent_id) {{
                collapsedNodes.delete(curr.parent_id);
                curr = tasks.find(x => x.id === curr.parent_id);
            }}
            renderTable();
            const row = document.getElementById(`task-row-${{taskId}}`);
            if (row) {{
                row.scrollIntoView({{ behavior: 'smooth', block: 'center' }});
                row.classList.remove('flash');
                void row.offsetWidth;
                row.classList.add('flash');
            }}
        }}

        function refreshAlertsAndTable() {{
            renderAlerts();
            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {{
                renderGantt();
            }}
        }}

        function switchTab(viewId, btnEl) {{
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));

            btnEl.classList.add('active');
            document.getElementById('view-' + viewId).classList.add('active');

            if (viewId === 'calendar') {{
                renderGantt();
            }}
        }}

        function toggleCollapse(id) {{
            if (isFiltering && document.getElementById('view-dashboard').classList.contains('active')) return;
            if (collapsedNodes.has(id)) collapsedNodes.delete(id);
            else collapsedNodes.add(id);

            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {{
                renderGantt();
            }}
        }}

        function expandAll() {{
            collapsedNodes.clear();
            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {{
                renderGantt();
            }}
        }}

        function collapseAll() {{
            tasks.forEach(t => {{
                if (t.has_children) collapsedNodes.add(t.id);
            }});
            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {{
                renderGantt();
            }}
        }}

        function toggleDepLines() {{
            showDepLines = !showDepLines;
            const btn = document.getElementById('toggleDepBtn');
            btn.textContent = `依存関係線: ${{showDepLines ? 'ON' : 'OFF'}}`;
            btn.classList.toggle('active', showDepLines);
            renderGantt();
        }}

        function applyFilter() {{
            const txt = document.getElementById('searchInput').value.toLowerCase();
            const res = document.getElementById('resourceFilter').value;
            const alertOnly = document.getElementById('alertOnlyCheck').checked;
            isFiltering = (txt !== '' || res !== '' || alertOnly);
            renderTable();
        }}

        function isTaskHiddenByCollapse(t) {{
            let curr = tasks.find(x => x.id === t.parent_id);
            while (curr) {{
                if (collapsedNodes.has(curr.id)) return true;
                curr = tasks.find(x => x.id === curr.parent_id);
            }}
            return false;
        }}

        function renderDashboard() {{
            const lvl1Tasks = tasks.filter(t => t.level === 1);
            const avgProgress = lvl1Tasks.length
                ? (lvl1Tasks.reduce((s, t) => s + parseFloat(t.progress || 0), 0) / lvl1Tasks.length) * 100
                : 0;

            const radius = 56;
            const circumference = 2 * Math.PI * radius;
            const offset = circumference - (avgProgress / 100) * circumference;

            document.getElementById('pie-chart-container').innerHTML = `
                <svg width="150" height="150" viewBox="0 0 140 140">
                    <circle cx="70" cy="70" r="${{radius}}" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="12" />
                    <circle cx="70" cy="70" r="${{radius}}" fill="none" stroke="#00f3ff" stroke-width="12"
                            stroke-dasharray="${{circumference}}" stroke-dashoffset="${{offset}}"
                            stroke-linecap="round" transform="rotate(-90 70 70)" style="filter: drop-shadow(0 0 8px #00f3ff);" />
                    <text x="70" y="77" text-anchor="middle" fill="#e2e8f0" font-size="22" font-family="monospace" font-weight="bold">${{avgProgress.toFixed(1)}}%</text>
                </svg>
            `;

            let html = '';
            lvl1Tasks.forEach(t => {{
                const p = (parseFloat(t.progress || 0) * 100).toFixed(0);
                html += `
                    <div class="bar-item">
                        <div class="bar-label" title="${{t.name}}">${{t.name}}</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: ${{p}}%"></div>
                        </div>
                        <div class="bar-percent">${{p}}%</div>
                    </div>`;
            }});
            document.getElementById('bar-chart-container').innerHTML = html;
        }}

        function renderTable() {{
            const tbody = document.querySelector('#wbs-table tbody');
            const txt = document.getElementById('searchInput').value.toLowerCase();
            const res = document.getElementById('resourceFilter').value;
            const alertOnly = document.getElementById('alertOnlyCheck').checked;

            let visibleSet = new Set();
            if (isFiltering) {{
                tasks.forEach(t => {{
                    let match = true;
                    if (txt && !t.name.toLowerCase().includes(txt) && !String(t.id).includes(txt)) match = false;
                    if (res && t.resource !== res) match = false;
                    if (alertOnly && !getAlertInfo(t)) match = false;

                    if (match) {{
                        visibleSet.add(t.id);
                        let curr = tasks.find(x => x.id === t.parent_id);
                        while (curr) {{
                            visibleSet.add(curr.id);
                            curr = tasks.find(x => x.id === curr.parent_id);
                        }}
                    }}
                }});
            }}

            let html = '';
            tasks.forEach(t => {{
                if (isFiltering) {{
                    if (!visibleSet.has(t.id)) return;
                }} else {{
                    if (isTaskHiddenByCollapse(t)) return;
                }}

                const pad = (t.level - 1) * 18;
                const prog = (parseFloat(t.progress || 0) * 100).toFixed(0);
                const alertInfo = getAlertInfo(t);

                let rowClasses = [];
                if (t.level === 1) rowClasses.push('lvl-1');
                if (alertInfo) rowClasses.push(alertInfo.type === 'overdue' ? 'row-overdue' : 'row-soon');

                let toggleIcon = '<span style="display:inline-block; width:22px;"></span>';
                if (t.has_children) {{
                    const icon = collapsedNodes.has(t.id) ? '+' : '-';
                    toggleIcon = `<span class="toggle-btn" onclick="toggleCollapse('${{t.id}}')">[${{icon}}]</span>`;
                }}

                let alertPill = '';
                if (alertInfo) {{
                    const pillClass = alertInfo.type === 'overdue' ? 'pill-overdue' : 'pill-soon';
                    alertPill = `<span class="status-pill ${{pillClass}}">${{alertInfo.label}}</span>`;
                }}

                const predText = t.predecessors.length ? `先:${{t.predecessors.join(',')}}` : '';
                const succText = t.successors.length ? `後:${{t.successors.join(',')}}` : '';
                const depDisplay = [predText, succText].filter(Boolean).join(' / ') || '-';

                html += `
                    <tr id="task-row-${{t.id}}" class="${{rowClasses.join(' ')}}">
                        <td style="color: var(--text-muted); font-family:monospace;">${{t.id}}</td>
                        <td style="padding-left: ${{pad + 8}}px;">
                            ${{toggleIcon}}
                            ${{t.name}}
                            ${{alertPill}}
                        </td>
                        <td>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <div style="width:55px; background:rgba(255,255,255,0.1); height:6px; border-radius:3px;">
                                    <div style="height:100%; width:${{prog}}%; background:var(--neon-green); box-shadow:0 0 5px var(--neon-green); border-radius:3px;"></div>
                                </div>
                                <span style="font-family:monospace; font-size:0.8rem;">${{prog}}%</span>
                            </div>
                        </td>
                        <td style="font-size:0.8rem; color:var(--text-muted);">${{t.duration || '-'}} / ${{t.work_hours || '-'}}</td>
                        <td style="font-family:monospace;">${{t.start || '-'}}</td>
                        <td style="font-family:monospace;">${{t.end || '-'}}</td>
                        <td style="font-family:monospace; color:${{t.deadline ? 'var(--text-main)' : 'var(--text-muted)'}};">${{t.deadline || 'N/A'}}</td>
                        <td>${{t.resource || '-'}}</td>
                        <td style="font-size:0.78rem; color:var(--text-muted); font-family:monospace;">${{depDisplay}}</td>
                    </tr>
                `;
            }});
            tbody.innerHTML = html;
        }}

        function renderGantt() {{
            const labelsContainer = document.getElementById('gantt-labels');
            const timelineContainer = document.getElementById('gantt-timeline');

            const validTasks = tasks.filter(t => t.start && t.end);
            if (validTasks.length === 0) {{
                labelsContainer.innerHTML = '<div style="padding:15px;">日付データがありません</div>';
                return;
            }}

            const allTimes = validTasks.flatMap(t => [parseLocalDate(t.start).getTime(), parseLocalDate(t.end).getTime()]);
            allTimes.push(todayDate.getTime());

            const dayMs = 24 * 60 * 60 * 1000;
            const minDate = Math.min(...allTimes) - dayMs * 10;
            const maxDate = Math.max(...allTimes) + dayMs * 18;

            const totalDays = Math.ceil((maxDate - minDate) / dayMs);
            const dayWidth = parseInt(document.getElementById('ganttZoom').value, 10) || 5;
            const rowHeight = 34;

            // 年月ヘッダー生成
            let headerHtml = `<div class="g-header" style="width:${{totalDays * dayWidth}}px; height: 35px;">`;
            let currentMonth = '';
            let monthDays = 0;

            for (let i = 0; i < totalDays; i++) {{
                const d = new Date(minDate + i * dayMs);
                const m = `${{d.getFullYear()}}-${{String(d.getMonth() + 1).padStart(2, '0')}}`;
                if (m !== currentMonth) {{
                    if (currentMonth !== '') {{
                        headerHtml += `<div class="g-month" style="width:${{monthDays * dayWidth}}px">${{currentMonth}}</div>`;
                    }}
                    currentMonth = m;
                    monthDays = 1;
                }} else {{
                    monthDays++;
                }}
            }}
            headerHtml += `<div class="g-month" style="width:${{monthDays * dayWidth}}px">${{currentMonth}}</div></div>`;

            // 折りたたみ状態を反映した表示対象タスクリスト
            const visibleTasks = tasks.filter(t => !isTaskHiddenByCollapse(t));

            let labelsHtml = `<div style="height:35px; border-bottom:1px solid rgba(0,243,255,0.25); background:rgba(10,18,38,0.98); display:flex; align-items:center; padding-left:12px; font-size:0.8rem; color:var(--neon-blue); letter-spacing:1px;">TASK HIERARCHY</div>`;
            let barsHtml = headerHtml;

            // TODAYラインの描画
            const todayX = ((todayDate.getTime() - minDate) / dayMs) * dayWidth;
            barsHtml += `<div class="g-today-line" style="left:${{todayX}}px;"><span class="g-today-label">TODAY</span></div>`;

            let yOffset = 35;
            const barPosMap = {{}};

            visibleTasks.forEach(t => {{
                const pad = (t.level - 1) * 15;
                const color = t.level === 1 ? 'var(--neon-blue)' : 'var(--text-main)';
                const fontWeight = t.level === 1 ? 'bold' : 'normal';

                let toggleIcon = '<span style="display:inline-block; width:20px; flex-shrink:0;"></span>';
                if (t.has_children) {{
                    const icon = collapsedNodes.has(t.id) ? '+' : '-';
                    toggleIcon = `<span class="toggle-btn" style="flex-shrink:0;" onclick="toggleCollapse('${{t.id}}')">[${{icon}}]</span>`;
                }}

                labelsHtml += `
                    <div class="g-row-label" style="height:${{rowHeight}}px; padding-left:${{pad + 8}}px; color:${{color}}; font-weight:${{fontWeight}};" title="[${{t.id}}] ${{t.name}}">
                        ${{toggleIcon}}
                        <span style="overflow:hidden; text-overflow:ellipsis;">${{t.name}}</span>
                    </div>`;

                barsHtml += `<div class="g-row-bg" style="top:${{yOffset}}px; height:${{rowHeight}}px;"></div>`;

                if (t.start && t.end) {{
                    const sTime = parseLocalDate(t.start).getTime();
                    const eTime = parseLocalDate(t.end).getTime();
                    const startX = ((sTime - minDate) / dayMs) * dayWidth;
                    const w = Math.max(((eTime - sTime) / dayMs) * dayWidth, 6);
                    const centerY = yOffset + rowHeight / 2;

                    barPosMap[t.id] = {{ startX, endX: startX + w, centerY }};

                    const alertInfo = getAlertInfo(t);
                    let barColor = t.level === 1 ? 'var(--neon-purple)' : 'var(--neon-blue)';
                    let textColor = t.level === 1 ? '#fff' : '#000';
                    let glowColor = barColor;

                    if (alertInfo) {{
                        if (alertInfo.type === 'overdue') {{
                            barColor = 'var(--neon-red)';
                            textColor = '#fff';
                            glowColor = 'var(--neon-red)';
                        }} else {{
                            barColor = 'var(--neon-amber)';
                            textColor = '#000';
                            glowColor = 'var(--neon-amber)';
                        }}
                    }}

                    const prog = (parseFloat(t.progress || 0) * 100).toFixed(0);
                    barsHtml += `
                        <div class="g-bar"
                             data-task-id="${{t.id}}"
                             onmouseenter="highlightDeps('${{t.id}}')"
                             onmouseleave="clearDepHighlight()"
                             style="top:${{yOffset + 8}}px; left:${{startX}}px; width:${{w}}px; background:${{barColor}}; color:${{textColor}}; box-shadow: 0 0 8px ${{glowColor}};"
                             title="[ID:${{t.id}}] ${{t.name}} (${{t.start}} 〜 ${{t.end}} / 進捗:${{prog}}%)">
                            ${{w > 28 ? prog + '%' : ''}}
                        </div>`;
                }}
                yOffset += rowHeight;
            }});

            // 先行・後続タスクの依存関係線（SVG）生成
            if (showDepLines) {{
                const edgeSet = new Set();
                const edges = [];

                visibleTasks.forEach(t => {{
                    (t.predecessors || []).forEach(predId => {{
                        const key = `${{predId}}->${{t.id}}`;
                        if (!edgeSet.has(key)) {{
                            edgeSet.add(key);
                            edges.push({{ from: predId, to: t.id }});
                        }}
                    }});
                    (t.successors || []).forEach(succId => {{
                        const key = `${{t.id}}->${{succId}}`;
                        if (!edgeSet.has(key)) {{
                            edgeSet.add(key);
                            edges.push({{ from: t.id, to: succId }});
                        }}
                    }});
                }});

                let pathsHtml = '';
                edges.forEach(edge => {{
                    const fromPos = barPosMap[edge.from];
                    const toPos = barPosMap[edge.to];
                    if (!fromPos || !toPos) return;

                    const x1 = fromPos.endX;
                    const y1 = fromPos.centerY;
                    const x2 = toPos.startX;
                    const y2 = toPos.centerY;
                    const gap = 10;

                    let d = '';
                    if (x2 >= x1 + gap) {{
                        // 順方向: 右へ少し出てから縦線で降り/上がり、後続バー左端へ接続
                        const midX = x1 + gap;
                        d = `M ${{x1}} ${{y1}} L ${{midX}} ${{y1}} L ${{midX}} ${{y2}} L ${{x2}} ${{y2}}`;
                    }} else {{
                        // 逆方向または重複: 一旦右へ出て中間Yを通って左へ回り込み縦線で接続
                        const outX = x1 + gap;
                        const inX = Math.max(0, x2 - gap);
                        const midY = y1 + (y2 > y1 ? rowHeight / 2 : -rowHeight / 2);
                        d = `M ${{x1}} ${{y1}} L ${{outX}} ${{y1}} L ${{outX}} ${{midY}} L ${{inX}} ${{midY}} L ${{inX}} ${{y2}} L ${{x2}} ${{y2}}`;
                    }}

                    pathsHtml += `<path class="dep-path" data-from="${{edge.from}}" data-to="${{edge.to}}" d="${{d}}" marker-end="url(#dep-arrow)" />`;
                }});

                const totalWidth = totalDays * dayWidth;
                barsHtml += `
                    <svg class="dep-svg" width="${{totalWidth}}" height="${{yOffset}}">
                        <defs>
                            <marker id="dep-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                                <path d="M 0 1 L 7 4 L 0 7 z" fill="#00f3ff" />
                            </marker>
                        </defs>
                        ${{pathsHtml}}
                    </svg>`;
            }}

            labelsContainer.innerHTML = labelsHtml;
            timelineContainer.innerHTML = barsHtml;
            timelineContainer.style.width = (totalDays * dayWidth) + 'px';
            timelineContainer.style.height = yOffset + 'px';
        }}

        function highlightDeps(taskId) {{
            const paths = document.querySelectorAll('.dep-path');
            if (!paths.length) return;
            paths.forEach(p => {{
                if (p.dataset.from === taskId || p.dataset.to === taskId) {{
                    p.classList.add('highlighted');
                    p.classList.remove('dimmed');
                }} else {{
                    p.classList.add('dimmed');
                    p.classList.remove('highlighted');
                }}
            }});
        }}

        function clearDepHighlight() {{
            document.querySelectorAll('.dep-path').forEach(p => {{
                p.classList.remove('highlighted', 'dimmed');
            }});
        }}

        function syncScroll() {{
            const timeline = document.getElementById('gantt-scroll');
            const labels = document.getElementById('gantt-labels');
            labels.scrollTop = timeline.scrollTop;
        }}

        document.addEventListener('DOMContentLoaded', () => {{
            initData();
            renderAlerts();
            renderDashboard();
            renderTable();
        }});
    </script>
</body>
</html>"""

        output_dir = os.path.dirname(os.path.abspath(file_path))
        output_file = os.path.join(output_dir, 'cyber_wbs_dashboard.html')

        with open(output_file, 'w', encoding='utf-8') as f:
            f.write(html_content)

        print(f"✅ 作成完了: {output_file}")
        try:
            messagebox.showinfo("完了", f"ダッシュボードの作成が完了しました。\n\n保存先:\n{output_file}")
        except Exception:
            pass

    except Exception as e:
        print(f"❌ エラーが発生しました: {e}")
        try:
