        .gantt-timeline {{ position: relative; min-height: 100%; }}

        .g-header {{
            display: flex;
            background: rgba(10, 18, 38, 0.98);
            position: sticky;
            top: 0;
            z-index: 25;
            border-bottom: 1px solid rgba(0,243,255,0.25);
        }}
        .g-month {{
            color: var(--neon-blue);
            font-size: 0.76rem;
            font-family: monospace;
            text-align: center;
            border-right: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            justify-content: center;
        }}

        .g-row-label {{
            padding: 0 10px;
            font-size: 0.82rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            cursor: pointer;
        }}
        .g-row-label:hover {{ background: rgba(0, 243, 255, 0.08); }}
        .g-row-bg {{ border-bottom: 1px solid rgba(255,255,255,0.03); position: absolute; width: 100%; left: 0; }}

        .g-bar {{
            position: absolute;
            height: 18px;
            border-radius: 3px;
            font-size: 0.7rem;
            font-weight: bold;
            display: flex;
            align-items: center;
            padding: 0 5px;
            overflow: hidden;
            white-space: nowrap;
            cursor: pointer;
            transition: filter 0.2s, transform 0.15s;
            z-index: 10;
        }}
        .g-bar:hover {{ filter: brightness(1.25); transform: scaleY(1.12); z-index: 20; }}

        .g-today-line {{
            position: absolute;
            top: 35px;
            bottom: 0;
            width: 2px;
            background: var(--neon-green);
            box-shadow: 0 0 8px var(--neon-green);
            z-index: 15;
            pointer-events: none;
        }}
        .g-today-label {{
            position: sticky;
            top: 36px;
            background: var(--neon-green);
            color: #000;
            font-size: 0.65rem;
            font-weight: bold;
            padding: 1px 4px;
            border-radius: 2px;
            transform: translateX(-50%);
            display: inline-block;
        }}

        /* Dependency SVG Layer */
        .dep-svg {{
            position: absolute;
            top: 0;
            left: 0;
            pointer-events: none;
            z-index: 6;
        }}
        .dep-path {{
            fill: none;
            stroke: rgba(0, 243, 255, 0.38);
            stroke-width: 1.4;
            transition: stroke 0.2s, stroke-width 0.2s, opacity 0.2s;
        }}
        .dep-path.dimmed {{ opacity: 0.12; }}
        .dep-path.highlighted {{
            stroke: #ff00ea;
            stroke-width: 2.5;
            opacity: 1;
            filter: drop-shadow(0 0 4px #ff00ea);
        }}

        /* Scrollbar */
        ::-webkit-scrollbar {{ width: 8px; height: 8px; }}
        ::-webkit-scrollbar-track {{ background: rgba(0,0,0,0.25); }}
        ::-webkit-scrollbar-thumb {{ background: rgba(0,243,255,0.3); border-radius: 4px; }}
        ::-webkit-scrollbar-thumb:hover {{ background: var(--neon-blue); }}
    </style>
</head>
<body>

    <div class="header">
        <div class="header-left">
            <h1>SYS-WBS DASHBOARD</h1>
            <span class="today-badge" id="todayDisplay">TODAY: ----/--/--</span>
        </div>
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('dashboard', this)">DETAILS &amp; CHARTS</button>
            <button class="tab-btn" onclick="switchTab('calendar', this)">GANTT CALENDAR</button>
        </div>
    </div>

    <!-- DASHBOARD VIEW -->
    <div id="view-dashboard" class="view-container view active">
        <!-- DEADLINE ALERT PANEL (COLLAPSIBLE) -->
        <div class="panel alert-panel" id="panel-alerts">
            <div class="panel-header" style="border-bottom-color: rgba(255, 42, 95, 0.3);">
                <div class="panel-title-clickable" onclick="togglePanel('panel-alerts')">
                    <span class="section-chevron">▼</span>
                    <span class="alert-title">DEADLINE ALERTS</span>
                    <span id="alertSummaryBadges"></span>
                </div>
                <div class="filter-bar" onclick="event.stopPropagation()">
                    <select id="alertThreshold" class="input-glow" onchange="refreshAlertsAndTable()">
                        <option value="7">7日以内を警告</option>
                        <option value="14" selected>14日以内を警告</option>
                        <option value="30">30日以内を警告</option>
                        <option value="60">60日以内を警告</option>
                    </select>
                    <select id="alertDateBasis" class="input-glow" onchange="refreshAlertsAndTable()">
                        <option value="deadline_or_end" selected>基準: 期限優先 (N/Aは終了日)</option>
                        <option value="deadline_only">基準: 「期限」列のみ</option>
                    </select>
                </div>
            </div>
            <div class="panel-body">
                <div class="alert-list" id="alertListContainer"></div>
            </div>
        </div>

        <!-- TOTAL PROGRESS & PHASE PROGRESS (COLLAPSIBLE) -->
        <div class="dashboard-grid">
            <div class="panel" id="panel-total-progress">
                <div class="panel-header">
                    <div class="panel-title-clickable" onclick="togglePanel('panel-total-progress')">
                        <span class="section-chevron">▼</span>
                        <span>TOTAL PROGRESS</span>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="pie-container" id="pie-chart-container"></div>
                </div>
            </div>

            <div class="panel" id="panel-phase-progress">
                <div class="panel-header">
                    <div class="panel-title-clickable" onclick="togglePanel('panel-phase-progress')">
                        <span class="section-chevron">▼</span>
                        <span>PHASE PROGRESS (Level 1)</span>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="bar-chart" id="bar-chart-container"></div>
                </div>
            </div>
        </div>

        <!-- TASK DETAILS TABLE -->
        <div class="panel" style="flex:1; min-height: 260px;">
            <div class="panel-header">
                <span>TASK DETAILS <small style="color:var(--text-muted); font-size:0.74rem; margin-left:6px;">(行クリックで詳細表示)</small></span>
                <div class="filter-bar">
                    <button class="mini-btn" onclick="expandAll()">すべて展開</button>
                    <button class="mini-btn" onclick="collapseAll()">すべて折りたたむ</button>
                    <label style="font-size:0.78rem; color:var(--text-main); display:flex; align-items:center; gap:5px; cursor:pointer;">
                        <input type="checkbox" id="alertOnlyCheck" onchange="applyFilter()"> アラート対象のみ
                    </label>
                    <input type="text" id="searchInput" class="input-glow" placeholder="タスク名 / ID 検索..." onkeyup="applyFilter()">
                    <select id="resourceFilter" class="input-glow" onchange="applyFilter()">
                        <option value="">すべてのリソース</option>
                    </select>
                </div>
            </div>
            <div class="table-container">
                <table id="wbs-table">
                    <thead>
                        <tr>
                            <th style="width: 65px;">ID</th>
                            <th>タスク名</th>
                            <th style="width: 140px;">達成率</th>
                            <th style="width: 120px;">期間 / 工数</th>
                            <th style="width: 105px;">開始日</th>
                            <th style="width: 105px;">終了日</th>
                            <th style="width: 105px;">期限</th>
                            <th style="width: 130px;">リソース</th>
                            <th style="width: 110px;">先行 / 後続</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- CALENDAR (GANTT) VIEW -->
    <div id="view-calendar" class="view-container view">
        <div class="gantt-toolbar">
            <div class="filter-bar">
                <button class="mini-btn" onclick="expandAll()">すべて展開</button>
                <button class="mini-btn" onclick="collapseAll()">すべて折りたたむ</button>
                <button class="mini-btn active" id="toggleDepBtn" onclick="toggleDepLines()">依存関係線: ON</button>
                <select id="ganttZoom" class="input-glow" onchange="renderGantt()">
                    <option value="3">表示倍率: 広域 (3px/日)</option>
                    <option value="5" selected>表示倍率: 標準 (5px/日)</option>
                    <option value="9">表示倍率: 詳細 (9px/日)</option>
                </select>
            </div>
            <div class="gantt-legend">
                <span><i class="legend-dot" style="background:var(--neon-purple);"></i>Level 1</span>
                <span><i class="legend-dot" style="background:var(--neon-blue);"></i>通常タスク</span>
                <span><i class="legend-dot" style="background:var(--neon-amber);"></i>期限間近</span>
                <span><i class="legend-dot" style="background:var(--neon-red);"></i>期限超過</span>
                <span><i class="legend-dot" style="background:var(--neon-green);"></i>TODAY</span>
            </div>
        </div>
        <div class="gantt-wrapper">
            <div class="gantt-labels" id="gantt-labels"></div>
            <div class="gantt-timeline-container" id="gantt-scroll" onscroll="syncScroll()">
                <div class="gantt-timeline" id="gantt-timeline"></div>
            </div>
        </div>
    </div>

    <!-- GRAPHICAL TASK DETAIL DRAWER -->
    <div class="drawer-backdrop" id="drawerBackdrop" onclick="closeTaskDetail()"></div>
    <aside class="task-drawer" id="taskDrawer">
        <div class="drawer-header">
            <div style="flex:1; min-width:0;">
                <div class="drawer-breadcrumbs" id="drawerBreadcrumbs"></div>
                <div class="drawer-title-row">
                    <span class="drawer-id-tag" id="drawerTaskId">ID: -</span>
                    <span id="drawerAlertBadge"></span>
                </div>
                <div class="drawer-task-name" id="drawerTaskName" style="margin-top:6px;">タスクを選択してください</div>
            </div>
            <button class="drawer-close-btn" onclick="closeTaskDetail()" title="閉じる (ESC)">✕</button>
        </div>
        <div class="drawer-body" id="drawerBody"></div>
    </aside>

    <script>
        let tasks = {json_data};
        let collapsedNodes = new Set();
        let isFiltering = false;
        let showDepLines = true;
        let selectedTaskId = null;

        // 今日の日付（00:00:00基準）
        const now = new Date();
        const todayDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const todayStr = `${{todayDate.getFullYear()}}-${{String(todayDate.getMonth() + 1).padStart(2, '0')}}-${{String(todayDate.getDate()).padStart(2, '0')}}`;

        function parseLocalDate(isoStr) {{
            if (!isoStr) return null;
            const parts = isoStr.split('-');
            if (parts.length !== 3) return null;
            return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
        }}

        function escapeHtml(str) {{
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }}

        function togglePanel(panelId) {{
            const panel = document.getElementById(panelId);
            if (panel) panel.classList.toggle('collapsed');
        }}

        function initData() {{
            document.getElementById('todayDisplay').textContent = `TODAY: ${{todayStr}}`;

            // PHASE PROGRESS: Level 1タスクの進捗を配下タスクの平均から自動計算
            const topLvlStats = {{}};
            tasks.forEach(t => {{
                if (t.level === 1) topLvlStats[t.id] = {{ sum: 0, count: 0 }};
            }});

            tasks.forEach(t => {{
                if (t.level > 1 && t.top_parent_id && topLvlStats[t.top_parent_id]) {{
                    topLvlStats[t.top_parent_id].sum += parseFloat(t.progress || 0);
                    topLvlStats[t.top_parent_id].count++;
                }}
            }});

            tasks.forEach(t => {{
                if (t.level === 1 && topLvlStats[t.id].count > 0) {{
                    t.progress = topLvlStats[t.id].sum / topLvlStats[t.id].count;
                }}
            }});

            // リソースフィルター選択肢
            const resources = [...new Set(tasks.map(t => t.resource).filter(r => r))];
            const resSelect = document.getElementById('resourceFilter');
            resources.forEach(r => {{
                const opt = document.createElement('option');
                opt.value = r;
                opt.textContent = r;
                resSelect.appendChild(opt);
            }});
        }}

        function getAlertInfo(t) {{
            if (parseFloat(t.progress || 0) >= 0.999) return null;

            const threshold = parseInt(document.getElementById('alertThreshold').value, 10);
            const basis = document.getElementById('alertDateBasis').value;

            let targetStr = '';
            let basisLabel = '';
            if (basis === 'deadline_only') {{
                targetStr = t.deadline;
                basisLabel = '期限';
            }} else {{
                if (t.deadline) {{
                    targetStr = t.deadline;
                    basisLabel = '期限';
                }} else if (t.end) {{
                    targetStr = t.end;
                    basisLabel = '終了日';
                }}
            }}

            const targetDate = parseLocalDate(targetStr);
            if (!targetDate) return null;

            const diffDays = Math.round((targetDate - todayDate) / (1000 * 60 * 60 * 24));
            if (diffDays < 0) {{
                return {{ type: 'overdue', diffDays, targetStr, basisLabel, label: `${{Math.abs(diffDays)}}日超過` }};
            }} else if (diffDays <= threshold) {{
                const dayText = diffDays === 0 ? '本日期限' : `あと${{diffDays}}日`;
                return {{ type: 'soon', diffDays, targetStr, basisLabel, label: dayText }};
            }}
            return null;
        }}

        function renderAlerts() {{
            const container = document.getElementById('alertListContainer');
            const summaryContainer = document.getElementById('alertSummaryBadges');

            const alerted = [];
            tasks.forEach(t => {{
                const info = getAlertInfo(t);
                if (info) alerted.push({{ task: t, info }});
            }});

            alerted.sort((a, b) => a.info.diffDays - b.info.diffDays);

            const overdueCount = alerted.filter(a => a.info.type === 'overdue').length;
            const soonCount = alerted.filter(a => a.info.type === 'soon').length;

            if (alerted.length === 0) {{
                summaryContainer.innerHTML = `<span class="alert-count-badge badge-ok">ALERT: 0件 (問題なし)</span>`;
                container.innerHTML = `<div style="font-size:0.82rem; color:var(--text-muted); padding:4px 0;">現在、期限超過または指定日数以内に期限を迎える未完了タスクはありません。</div>`;
                return;
            }}

            summaryContainer.innerHTML = `
                <span class="alert-count-badge badge-overdue">期限超過: ${{overdueCount}}件</span>
                <span class="alert-count-badge badge-soon">期限間近: ${{soonCount}}件</span>
            `;

            let html = '';
            alerted.forEach(({{ task, info }}) => {{
                const isOverdue = info.type === 'overdue';
                const cardClass = isOverdue ? 'alert-card overdue' : 'alert-card';
                const statusColor = isOverdue ? 'var(--neon-red)' : 'var(--neon-amber)';
                const prog = (parseFloat(task.progress || 0) * 100).toFixed(0);

                html += `
                    <div class="${{cardClass}}" onclick="openTaskDetail('${{task.id}}')">
                        <div class="alert-card-top">
                            <span style="color:var(--text-muted);">ID: ${{escapeHtml(task.id)}}</span>
                            <span style="color:${{statusColor}}; font-weight:bold;">[${{info.label}}]</span>
                        </div>
                        <div class="alert-card-name" title="${{escapeHtml(task.name)}}">${{escapeHtml(task.name)}}</div>
                        <div class="alert-card-meta">
                            <span>${{info.basisLabel}}: ${{info.targetStr}}</span>
                            <span>進捗: ${{prog}}%</span>
                        </div>
                    </div>
                `;
            }});
            container.innerHTML = html;
        }}

        function refreshAlertsAndTable() {{
            renderAlerts();
            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {{
                renderGantt();
            }}
            if (selectedTaskId) {{
                openTaskDetail(selectedTaskId, false);
            }}
        }}

        function switchTab(viewId, btnEl) {{
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));

            btnEl.classList.add('active');
            document.getElementById('view-' + viewId).classList.add('active');

            if (viewId === 'calendar') {{
                renderGantt();
            }}
        }}

        function toggleCollapse(id, e) {{
            if (e) e.stopPropagation();
            if (isFiltering && document.getElementById('view-dashboard').classList.contains('active')) return;
            if (collapsedNodes.has(id)) collapsedNodes.delete(id);
            else collapsedNodes.add(id);

            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {{
                renderGantt();
            }}
        }}

        function expandAll() {{
            collapsedNodes.clear();
            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {{
                renderGantt();
            }}
        }}

        function collapseAll() {{
            tasks.forEach(t => {{
                if (t.has_children) collapsedNodes.add(t.id);
            }});
            renderTable();
            if (document.getElementById('view-calendar').classList.contains('active')) {{
                renderGantt();
            }}
        }}

        function toggleDepLines() {{
            showDepLines = !showDepLines;
            const btn = document.getElementById('toggleDepBtn');
            btn.textContent = `依存関係線: ${{showDepLines ? 'ON' : 'OFF'}}`;
            btn.classList.toggle('active', showDepLines);
            renderGantt();
        }}

        function applyFilter() {{
            const txt = document.getElementById('searchInput').value.toLowerCase();
            const res = document.getElementById('resourceFilter').value;
            const alertOnly = document.getElementById('alertOnlyCheck').checked;
            isFiltering = (txt !== '' || res !== '' || alertOnly);
            renderTable();
        }}

        function isTaskHiddenByCollapse(t) {{
            let curr = tasks.find(x => x.id === t.parent_id);
            while (curr) {{
                if (collapsedNodes.has(curr.id)) return true;
                curr = tasks.find(x => x.id === curr.parent_id);
            }}
            return false;
        }}

        function renderDashboard() {{
            const lvl1Tasks = tasks.filter(t => t.level === 1);
            const avgProgress = lvl1Tasks.length
                ? (lvl1Tasks.reduce((s, t) => s + parseFloat(t.progress || 0), 0) / lvl1Tasks.length) * 100
                : 0;

            const radius = 56;
            const circumference = 2 * Math.PI * radius;
            const offset = circumference - (avgProgress / 100) * circumference;

            document.getElementById('pie-chart-container').innerHTML = `
                <svg width="146" height="146" viewBox="0 0 140 140">
                    <circle cx="70" cy="70" r="${{radius}}" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="12" />
                    <circle cx="70" cy="70" r="${{radius}}" fill="none" stroke="#00f3ff" stroke-width="12"
                            stroke-dasharray="${{circumference}}" stroke-dashoffset="${{offset}}"
                            stroke-linecap="round" transform="rotate(-90 70 70)" style="filter: drop-shadow(0 0 8px #00f3ff);" />
                    <text x="70" y="77" text-anchor="middle" fill="#e2e8f0" font-size="22" font-family="monospace" font-weight="bold">${{avgProgress.toFixed(1)}}%</text>
                </svg>
            `;

            let html = '';
            lvl1Tasks.forEach(t => {{
                const p = (parseFloat(t.progress || 0) * 100).toFixed(0);
                html += `
                    <div class="bar-item" onclick="openTaskDetail('${{t.id}}')">
                        <div class="bar-label" title="${{escapeHtml(t.name)}}">${{escapeHtml(t.name)}}</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: ${{p}}%"></div>
                        </div>
                        <div class="bar-percent">${{p}}%</div>
                    </div>`;
            }});
            document.getElementById('bar-chart-container').innerHTML = html;
        }}

        function renderTable() {{
            const tbody = document.querySelector('#wbs-table tbody');
            const txt = document.getElementById('searchInput').value.toLowerCase();
            const res = document.getElementById('resourceFilter').value;
            const alertOnly = document.getElementById('alertOnlyCheck').checked;

            let visibleSet = new Set();
            if (isFiltering) {{
                tasks.forEach(t => {{
                    let match = true;
                    if (txt && !t.name.toLowerCase().includes(txt) && !String(t.id).includes(txt)) match = false;
                    if (res && t.resource !== res) match = false;
                    if (alertOnly && !getAlertInfo(t)) match = false;

                    if (match) {{
                        visibleSet.add(t.id);
                        let curr = tasks.find(x => x.id === t.parent_id);
                        while (curr) {{
                            visibleSet.add(curr.id);
                            curr = tasks.find(x => x.id === curr.parent_id);
                        }}
                    }}
                }});
            }}

            let html = '';
            tasks.forEach(t => {{
                if (isFiltering) {{
                    if (!visibleSet.has(t.id)) return;
                }} else {{
                    if (isTaskHiddenByCollapse(t)) return;
                }}

                const pad = (t.level - 1) * 18;
                const prog = (parseFloat(t.progress || 0) * 100).toFixed(0);
                const alertInfo = getAlertInfo(t);

                let rowClasses = [];
                if (t.level === 1) rowClasses.push('lvl-1');
                if (alertInfo) rowClasses.push(alertInfo.type === 'overdue' ? 'row-overdue' : 'row-soon');
                if (selectedTaskId === t.id) rowClasses.push('selected-row');

                let toggleIcon = '<span style="display:inline-block; width:22px;"></span>';
                if (t.has_children) {{
                    const icon = collapsedNodes.has(t.id) ? '+' : '-';
                    toggleIcon = `<span class="toggle-btn" onclick="toggleCollapse('${{t.id}}', event)">[${{icon}}]</span>`;
                }}

                let alertPill = '';
                if (alertInfo) {{
                    const pillClass = alertInfo.type === 'overdue' ? 'pill-overdue' : 'pill-soon';
                    alertPill = `<span class="status-pill ${{pillClass}}">${{alertInfo.label}}</span>`;
                }}

                const predText = t.predecessors.length ? `先:${{t.predecessors.join(',')}}` : '';
                const succText = t.successors.length ? `後:${{t.successors.join(',')}}` : '';
                const depDisplay = [predText, succText].filter(Boolean).join(' / ') || '-';

                html += `
                    <tr id="task-row-${{t.id}}" class="${{rowClasses.join(' ')}}" onclick="openTaskDetail('${{t.id}}')">
                        <td style="color: var(--text-muted); font-family:monospace;">${{escapeHtml(t.id)}}</td>
                        <td style="padding-left: ${{pad + 8}}px;">
                            ${{toggleIcon}}
                            ${{escapeHtml(t.name)}}
                            ${{alertPill}}
                        </td>
                        <td>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <div style="width:55px; background:rgba(255,255,255,0.1); height:6px; border-radius:3px;">
                                    <div style="height:100%; width:${{prog}}%; background:var(--neon-green); box-shadow:0 0 5px var(--neon-green); border-radius:3px;"></div>
                                </div>
                                <span style="font-family:monospace; font-size:0.8rem;">${{prog}}%</span>
                            </div>
                        </td>
                        <td style="font-size:0.8rem; color:var(--text-muted);">${{escapeHtml(t.duration) || '-'}} / ${{escapeHtml(t.work_hours) || '-'}}</td>
                        <td style="font-family:monospace;">${{t.start || '-'}}</td>
                        <td style="font-family:monospace;">${{t.end || '-'}}</td>
                        <td style="font-family:monospace; color:${{t.deadline ? 'var(--text-main)' : 'var(--text-muted)'}};">${{t.deadline || 'N/A'}}</td>
                        <td>${{escapeHtml(t.resource) || '-'}}</td>
                        <td style="font-size:0.78rem; color:var(--text-muted); font-family:monospace;">${{escapeHtml(depDisplay)}}</td>
                    </tr>
                `;
            }});
            tbody.innerHTML = html;
        }}

        /* =========================================================
           GRAPHICAL TASK DETAIL HUD LOGIC
        ========================================================= */
        function openTaskDetail(taskId, scrollToRow = true) {{
            const task = tasks.find(t => String(t.id) === String(taskId));
            if (!task) return;

            selectedTaskId = task.id;

            // 親階層が折りたたまれていたら展開
            let pCursor = tasks.find(x => x.id === task.parent_id);
            while (pCursor) {{
                collapsedNodes.delete(pCursor.id);
                pCursor = tasks.find(x => x.id === pCursor.parent_id);
            }}
            renderTable();

            if (scrollToRow) {{
                const rowEl = document.getElementById(`task-row-${{task.id}}`);
                if (rowEl) rowEl.scrollIntoView({{ behavior: 'smooth', block: 'nearest' }});
            }}

            // パンくずリスト（上位階層）生成
            const ancestors = [];
            let curr = tasks.find(x => x.id === task.parent_id);
            while (curr) {{
                ancestors.unshift(curr);
                curr = tasks.find(x => x.id === curr.parent_id);
            }}
            const crumbHtml = ancestors.length
                ? ancestors.map(a => `<span class="crumb-link" onclick="openTaskDetail('${{a.id}}')">[${{escapeHtml(a.id)}}] ${{escapeHtml(a.name)}}</span>`).join(' <span>/</span> ')
                : '<span>ROOT LEVEL (Outline 1)</span>';
            document.getElementById('drawerBreadcrumbs').innerHTML = crumbHtml;

            document.getElementById('drawerTaskId').textContent = `ID: ${{task.id}} | LVL: ${{task.level}}`;
            document.getElementById('drawerTaskName').textContent = task.name;

            const alertInfo = getAlertInfo(task);
            const progFloat = parseFloat(task.progress || 0);
            const progPct = (progFloat * 100).toFixed(0);

            let statusBadgeHtml = '';
            if (progFloat >= 0.999) {{
                statusBadgeHtml = `<span class="alert-count-badge badge-ok">COMPLETED (100%)</span>`;
            }} else if (alertInfo) {{
                const cls = alertInfo.type === 'overdue' ? 'badge-overdue' : 'badge-soon';
                statusBadgeHtml = `<span class="alert-count-badge ${{cls}}">${{alertInfo.label}}</span>`;
            }} else {{
                statusBadgeHtml = `<span class="alert-count-badge" style="border:1px solid var(--neon-blue); color:var(--neon-blue); background:rgba(0,243,255,0.1);">IN PROGRESS</span>`;
            }}
            document.getElementById('drawerAlertBadge').innerHTML = statusBadgeHtml;

            // スケジュール経過率の計算（開始日〜終了日に対するTODAYの位置）
            let elapsedPct = 0;
            let scheduleNote = '日程データ不足';
            const sDate = parseLocalDate(task.start);
            const eDate = parseLocalDate(task.end);
            if (sDate && eDate) {{
                const totalSpan = Math.max(1, (eDate - sDate) / (1000 * 60 * 60 * 24));
                const elapsedSpan = (todayDate - sDate) / (1000 * 60 * 60 * 24);
                elapsedPct = Math.max(0, Math.min(100, (elapsedSpan / totalSpan) * 100));
                if (todayDate < sDate) {{
                    const untilStart = Math.round((sDate - todayDate) / (1000 * 60 * 60 * 24));
                    scheduleNote = `開始まであと ${{untilStart}}日`;
                }} else if (todayDate > eDate) {{
                    const pastEnd = Math.round((todayDate - eDate) / (1000 * 60 * 60 * 24));
                    scheduleNote = `終了予定日から ${{pastEnd}}日経過`;
                }} else {{
                    scheduleNote = `期間内の ${{elapsedPct.toFixed(0)}}% 経過`;
                }}
            }}

            // 円弧ゲージ計算
            const r = 46;
            const c = 2 * Math.PI * r;
            const dashOffset = c - (Math.min(100, progFloat * 100) / 100) * c;
            const gaugeColor = progFloat >= 0.999 ? 'var(--neon-green)' : (alertInfo && alertInfo.type === 'overdue' ? 'var(--neon-red)' : 'var(--neon-blue)');

            // 先行タスク・後続タスクの双方向解決
            const predIds = new Set(task.predecessors || []);
            const succIds = new Set(task.successors || []);
            tasks.forEach(other => {{
                if ((other.successors || []).includes(task.id)) predIds.add(other.id);
                if ((other.predecessors || []).includes(task.id)) succIds.add(other.id);
            }});

            const predTasks = [...predIds].map(id => tasks.find(t => t.id === id) || {{ id, name: `(外部/不明タスク ID:${{id}})`, progress: 0, missing: true }});
            const succTasks = [...succIds].map(id => tasks.find(t => t.id === id) || {{ id, name: `(外部/不明タスク ID:${{id}})`, progress: 0, missing: true }});

            const depSvgHtml = buildDependencyFlowSvg(task, predTasks, succTasks);

            // 配下サブタスク一覧（直下および子孫）
            const subTasks = [];
            const startIdx = tasks.findIndex(t => t.id === task.id);
            if (startIdx >= 0) {{
                for (let i = startIdx + 1; i < tasks.length; i++) {{
                    if (tasks[i].level <= task.level) break;
                    subTasks.push(tasks[i]);
                }}
            }}

            let subTasksHtml = '';
            if (subTasks.length > 0) {{
                const itemsHtml = subTasks.map(st => {{
                    const sp = (parseFloat(st.progress || 0) * 100).toFixed(0);
                    const indent = (st.level - task.level - 1) * 12;
                    return `
                        <div class="subtask-mini-item" style="margin-left:${{indent}}px;" onclick="openTaskDetail('${{st.id}}')">
                            <div style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                <span style="color:var(--text-muted); font-family:monospace; margin-right:6px;">#${{escapeHtml(st.id)}}</span>
                                <span>${{escapeHtml(st.name)}}</span>
                            </div>
                            <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">
                                <div style="width:45px; height:5px; background:rgba(255,255,255,0.1); border-radius:3px;">
                                    <div style="width:${{sp}}%; height:100%; background:var(--neon-blue); border-radius:3px;"></div>
                                </div>
                                <span style="font-family:monospace; font-size:0.75rem; color:var(--neon-blue);">${{sp}}%</span>
                            </div>
                        </div>`;
                }}).join('');

                subTasksHtml = `
                    <div class="hud-card">
                        <div class="hud-card-title">
                            <span>SUB-TASKS HIERARCHY (${{subTasks.length}}件)</span>
                            <span style="color:var(--text-muted); font-size:0.7rem;">クリックで詳細へ移動</span>
                        </div>
                        <div class="subtask-mini-list">${{itemsHtml}}</div>
                    </div>`;
            }}

            document.getElementById('drawerBody').innerHTML = `
                <!-- 1. PROGRESS & SCHEDULE ANALYTICS -->
                <div class="hud-card">
                    <div class="hud-card-title">
                        <span>PROGRESS &amp; SCHEDULE TELEMETRY</span>
                        <span style="color:var(--text-muted); font-size:0.72rem;">${{scheduleNote}}</span>
                    </div>
                    <div class="progress-hud-grid">
                        <div style="display:flex; flex-direction:column; align-items:center;">
                            <svg width="116" height="116" viewBox="0 0 116 116">
                                <circle cx="58" cy="58" r="${{r}}" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="10" />
                                <circle cx="58" cy="58" r="${{r}}" fill="none" stroke="${{gaugeColor}}" stroke-width="10"
                                        stroke-dasharray="${{c}}" stroke-dashoffset="${{dashOffset}}"
                                        stroke-linecap="round" transform="rotate(-90 58 58)"
                                        style="filter: drop-shadow(0 0 6px ${{gaugeColor}});" />
                                <text x="58" y="63" text-anchor="middle" fill="#fff" font-size="20" font-family="monospace" font-weight="bold">${{progPct}}%</text>
                            </svg>
                            <span style="font-size:0.7rem; color:var(--text-muted); margin-top:2px;">ACTUAL PROGRESS</span>
                        </div>

                        <div class="dual-bar-group">
                            <div class="dual-bar-row">
                                <div class="dual-bar-label">
                                    <span style="color:var(--neon-green);">実績達成率 (Actual)</span>
                                    <span style="font-family:monospace; font-weight:bold;">${{progPct}}%</span>
                                </div>
                                <div class="dual-bar-track">
                                    <div class="dual-bar-fill-actual" style="width:${{progPct}}%;"></div>
                                </div>
                            </div>
                            <div class="dual-bar-row">
                                <div class="dual-bar-label">
                                    <span style="color:var(--neon-blue);">日程経過率 (Time Elapsed)</span>
                                    <span style="font-family:monospace;">${{elapsedPct.toFixed(0)}}%</span>
                                </div>
                                <div class="dual-bar-track">
                                    <div class="dual-bar-fill-time" style="width:${{elapsedPct.toFixed(0)}}%;"></div>
                                </div>
                            </div>
                            <div style="font-size:0.74rem; color:var(--text-muted); display:flex; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.06); padding-top:6px;">
                                <span>開始: <strong style="color:var(--text-main);">${{task.start || '-'}}</strong></span>
                                <span>終了: <strong style="color:var(--text-main);">${{task.end || '-'}}</strong></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. RESOURCE & SCHEDULE SPECS -->
                <div class="hud-card">
                    <div class="hud-card-title"><span>TASK SPECIFICATIONS</span></div>
                    <div class="telemetry-grid">
                        <div class="tele-box">
                            <div class="tele-label">リソース (主担当)</div>
                            <div class="tele-val" style="color:var(--neon-blue);">${{escapeHtml(task.resource) || '未設定'}}</div>
                        </div>
                        <div class="tele-box">
                            <div class="tele-label">関係者 (サポート)</div>
                            <div class="tele-val">${{escapeHtml(task.stakeholder) || '-'}}</div>
                        </div>
                        <div class="tele-box">
                            <div class="tele-label">期限 (Deadline)</div>
                            <div class="tele-val" style="color:${{alertInfo ? 'var(--neon-red)' : 'var(--text-main)'}};">${{task.deadline || 'N/A'}}</div>
                        </div>
                        <div class="tele-box">
                            <div class="tele-label">作業時間</div>
                            <div class="tele-val">${{escapeHtml(task.work_hours) || '-'}}</div>
                        </div>
                        <div class="tele-box">
                            <div class="tele-label">期間</div>
                            <div class="tele-val">${{escapeHtml(task.duration) || '-'}}</div>
                        </div>
                        <div class="tele-box">
                            <div class="tele-label">前後リンク数</div>
                            <div class="tele-val">先:${{predTasks.length}} / 後:${{succTasks.length}}</div>
                        </div>
                    </div>
                </div>

                <!-- 3. DEPENDENCY FLOW GRAPH (PREDECESSORS -> CURRENT -> SUCCESSORS) -->
                <div class="hud-card">
                    <div class="hud-card-title">
                        <span>DEPENDENCY FLOW GRAPH</span>
                        <span style="color:var(--text-muted); font-size:0.7rem;">ノードクリックで前後タスクへ移動</span>
                    </div>
                    <div class="dep-diagram-wrap">
                        ${{depSvgHtml}}
                    </div>
                </div>

                <!-- 4. SUB-TASKS (IF ANY) -->
                ${{subTasksHtml}}
            `;

            document.getElementById('drawerBackdrop').classList.add('open');
            document.getElementById('taskDrawer').classList.add('open');
        }}

        function buildDependencyFlowSvg(currentTask, predTasks, succTasks) {{
            if (predTasks.length === 0 && succTasks.length === 0) {{
                return `<div style="padding:18px; text-align:center; color:var(--text-muted); font-size:0.8rem;">このタスクに紐づく先行タスク・後続タスクはありません。</div>`;
            }}

            const maxRows = Math.max(1, predTasks.length, succTasks.length);
            const nodeW = 148;
            const nodeH = 44;
            const gapY = 12;
            const svgW = 510;
            const svgH = Math.max(110, maxRows * (nodeH + gapY) + 16);

            const col1X = 8;
            const col2X = 181;
            const col3X = 354;
            const centerY = svgH / 2 - nodeH / 2;

            let paths = '';
            let nodes = '';

            // 先行タスク描画
            if (predTasks.length === 0) {{
                nodes += `
                    <rect x="${{col1X}}" y="${{centerY}}" width="${{nodeW}}" height="${{nodeH}}" rx="6" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.12)" stroke-dasharray="3,3" />
                    <text x="${{col1X + nodeW / 2}}" y="${{centerY + 26}}" text-anchor="middle" fill="#64748b" font-size="10">先行タスクなし</text>
                `;
            }} else {{
                const totalH = predTasks.length * nodeH + (predTasks.length - 1) * gapY;
                const startY = (svgH - totalH) / 2;

                predTasks.forEach((pt, idx) => {{
                    const ny = startY + idx * (nodeH + gapY);
                    const pPct = (parseFloat(pt.progress || 0) * 100).toFixed(0);
                    const strokeCol = pt.missing ? '#64748b' : (parseFloat(pt.progress || 0) >= 0.999 ? '#00ff66' : '#00f3ff');
                    const labelName = pt.name.length > 13 ? pt.name.slice(0, 13) + '…' : pt.name;

                    // 曲線コネクタ (先行右端 -> 中央左端)
                    const x1 = col1X + nodeW;
                    const y1 = ny + nodeH / 2;
                    const x2 = col2X;
                    const y2 = centerY + nodeH / 2;
                    const cx = (x1 + x2) / 2;
                    paths += `<path d="M ${{x1}} ${{y1}} C ${{cx}} ${{y1}}, ${{cx}} ${{y2}}, ${{x2}} ${{y2}}" fill="none" stroke="${{strokeCol}}" stroke-width="1.6" marker-end="url(#flow-arrow)" opacity="0.85" />`;

                    const clickAttr = pt.missing ? '' : `onclick="openTaskDetail('${{pt.id}}')"`;
                    nodes += `
                        <g class="dep-node-box" ${{clickAttr}}>
                            <rect x="${{col1X}}" y="${{ny}}" width="${{nodeW}}" height="${{nodeH}}" rx="6" fill="rgba(10,20,45,0.95)" stroke="${{strokeCol}}" stroke-width="1.3" />
                            <text x="${{col1X + 8}}" y="${{ny + 16}}" fill="${{strokeCol}}" font-size="9.5" font-family="monospace" font-weight="bold">PRE #${{escapeHtml(pt.id)}} (${{pPct}}%)</text>
                            <text x="${{col1X + 8}}" y="${{ny + 32}}" fill="#e2e8f0" font-size="10.5">${{escapeHtml(labelName)}}</text>
                        </g>
                    `;
                }});
            }}

            // 中央（現在選択中のタスク）
            const curPct = (parseFloat(currentTask.progress || 0) * 100).toFixed(0);
            const curName = currentTask.name.length > 13 ? currentTask.name.slice(0, 13) + '…' : currentTask.name;
            nodes += `
                <g>
                    <rect x="${{col2X}}" y="${{centerY}}" width="${{nodeW}}" height="${{nodeH}}" rx="6" fill="rgba(188,19,254,0.22)" stroke="#bc13fe" stroke-width="2" />
                    <text x="${{col2X + 8}}" y="${{centerY + 16}}" fill="#e9a8ff" font-size="9.5" font-family="monospace" font-weight="bold">CURRENT #${{escapeHtml(currentTask.id)}} (${{curPct}}%)</text>
                    <text x="${{col2X + 8}}" y="${{centerY + 32}}" fill="#ffffff" font-size="10.5" font-weight="bold">${{escapeHtml(curName)}}</text>
                </g>
            `;

            // 後続タスク描画
            if (succTasks.length === 0) {{
                nodes += `
                    <rect x="${{col3X}}" y="${{centerY}}" width="${{nodeW}}" height="${{nodeH}}" rx="6" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.12)" stroke-dasharray="3,3" />
                    <text x="${{col3X + nodeW / 2}}" y="${{centerY + 26}}" text-anchor="middle" fill="#64748b" font-size="10">後続タスクなし</text>
                `;
            }} else {{
                const totalH = succTasks.length * nodeH + (succTasks.length - 1) * gapY;
                const startY = (svgH - totalH) / 2;

                succTasks.forEach((st, idx) => {{
                    const ny = startY + idx * (nodeH + gapY);
                    const sPct = (parseFloat(st.progress || 0) * 100).toFixed(0);
                    const strokeCol = st.missing ? '#64748b' : '#ffaa00';
                    const labelName = st.name.length > 13 ? st.name.slice(0, 13) + '…' : st.name;

                    // 曲線コネクタ (中央右端 -> 後続左端)
                    const x1 = col2X + nodeW;
                    const y1 = centerY + nodeH / 2;
                    const x2 = col3X;
                    const y2 = ny + nodeH / 2;
                    const cx = (x1 + x2) / 2;
                    paths += `<path d="M ${{x1}} ${{y1}} C ${{cx}} ${{y1}}, ${{cx}} ${{y2}}, ${{x2}} ${{y2}}" fill="none" stroke="${{strokeCol}}" stroke-width="1.6" marker-end="url(#flow-arrow-amber)" opacity="0.85" />`;

                    const clickAttr = st.missing ? '' : `onclick="openTaskDetail('${{st.id}}')"`;
                    nodes += `
                        <g class="dep-node-box" ${{clickAttr}}>
                            <rect x="${{col3X}}" y="${{ny}}" width="${{nodeW}}" height="${{nodeH}}" rx="6" fill="rgba(10,20,45,0.95)" stroke="${{strokeCol}}" stroke-width="1.3" />
                            <text x="${{col3X + 8}}" y="${{ny + 16}}" fill="${{strokeCol}}" font-size="9.5" font-family="monospace" font-weight="bold">NEXT #${{escapeHtml(st.id)}} (${{sPct}}%)</text>
                            <text x="${{col3X + 8}}" y="${{ny + 32}}" fill="#e2e8f0" font-size="10.5">${{escapeHtml(labelName)}}</text>
                        </g>
                    `;
                }});
            }}

            return `
                <svg width="${{svgW}}" height="${{svgH}}" viewBox="0 0 ${{svgW}} ${{svgH}}">
                    <defs>
                        <marker id="flow-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
                            <path d="M 0 1 L 7 4 L 0 7 z" fill="#00f3ff" />
                        </marker>
                        <marker id="flow-arrow-amber" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
                            <path d="M 0 1 L 7 4 L 0 7 z" fill="#ffaa00" />
                        </marker>
                    </defs>
                    ${{paths}}
                    ${{nodes}}
                </svg>
            `;
        }}

        function closeTaskDetail() {{
            document.getElementById('drawerBackdrop').classList.remove('open');
            document.getElementById('taskDrawer').classList.remove('open');
        }}

        document.addEventListener('keydown', (e) => {{
            if (e.key === 'Escape') closeTaskDetail();
        }});

        /* =========================================================
           GANTT CALENDAR RENDERER
        ========================================================= */
        function renderGantt() {{
            const labelsContainer = document.getElementById('gantt-labels');
            const timelineContainer = document.getElementById('gantt-timeline');

            const validTasks = tasks.filter(t => t.start && t.end);
            if (validTasks.length === 0) {{
                labelsContainer.innerHTML = '<div style="padding:15px;">日付データがありません</div>';
                return;
            }}

            const allTimes = validTasks.flatMap(t => [parseLocalDate(t.start).getTime(), parseLocalDate(t.end).getTime()]);
            allTimes.push(todayDate.getTime());

            const dayMs = 24 * 60 * 60 * 1000;
            const minDate = Math.min(...allTimes) - dayMs * 10;
            const maxDate = Math.max(...allTimes) + dayMs * 18;

            const totalDays = Math.ceil((maxDate - minDate) / dayMs);
            const dayWidth = parseInt(document.getElementById('ganttZoom').value, 10) || 5;
            const rowHeight = 34;

            let headerHtml = `<div class="g-header" style="width:${{totalDays * dayWidth}}px; height: 35px;">`;
            let currentMonth = '';
            let monthDays = 0;

            for (let i = 0; i < totalDays; i++) {{
                const d = new Date(minDate + i * dayMs);
                const m = `${{d.getFullYear()}}-${{String(d.getMonth() + 1).padStart(2, '0')}}`;
                if (m !== currentMonth) {{
                    if (currentMonth !== '') {{
                        headerHtml += `<div class="g-month" style="width:${{monthDays * dayWidth}}px">${{currentMonth}}</div>`;
                    }}
                    currentMonth = m;
                    monthDays = 1;
                }} else {{
                    monthDays++;
                }}
            }}
            headerHtml += `<div class="g-month" style="width:${{monthDays * dayWidth}}px">${{currentMonth}}</div></div>`;

            const visibleTasks = tasks.filter(t => !isTaskHiddenByCollapse(t));

            let labelsHtml = `<div style="height:35px; border-bottom:1px solid rgba(0,243,255,0.25); background:rgba(10,18,38,0.98); display:flex; align-items:center; padding-left:12px; font-size:0.8rem; color:var(--neon-blue); letter-spacing:1px;">TASK HIERARCHY</div>`;
            let barsHtml = headerHtml;

            const todayX = ((todayDate.getTime() - minDate) / dayMs) * dayWidth;
            barsHtml += `<div class="g-today-line" style="left:${{todayX}}px;"><span class="g-today-label">TODAY</span></div>`;

            let yOffset = 35;
            const barPosMap = {{}};

            visibleTasks.forEach(t => {{
                const pad = (t.level - 1) * 15;
                const color = t.level === 1 ? 'var(--neon-blue)' : 'var(--text-main)';
                const fontWeight = t.level === 1 ? 'bold' : 'normal';

                let toggleIcon = '<span style="display:inline-block; width:20px; flex-shrink:0;"></span>';
                if (t.has_children) {{
                    const icon = collapsedNodes.has(t.id) ? '+' : '-';
                    toggleIcon = `<span class="toggle-btn" style="flex-shrink:0;" onclick="toggleCollapse('${{t.id}}', event)">[${{icon}}]</span>`;
                }}

                labelsHtml += `
                    <div class="g-row-label" onclick="openTaskDetail('${{t.id}}', false)" style="height:${{rowHeight}}px; padding-left:${{pad + 8}}px; color:${{color}}; font-weight:${{fontWeight}};" title="[${{escapeHtml(t.id)}}] ${{escapeHtml(t.name)}}">
                        ${{toggleIcon}}
                        <span style="overflow:hidden; text-overflow:ellipsis;">${{escapeHtml(t.name)}}</span>
                    </div>`;

                barsHtml += `<div class="g-row-bg" style="top:${{yOffset}}px; height:${{rowHeight}}px;"></div>`;

                if (t.start && t.end) {{
                    const sTime = parseLocalDate(t.start).getTime();
                    const eTime = parseLocalDate(t.end).getTime();
                    const startX = ((sTime - minDate) / dayMs) * dayWidth;
                    const w = Math.max(((eTime - sTime) / dayMs) * dayWidth, 6);
                    const centerY = yOffset + rowHeight / 2;

                    barPosMap[t.id] = {{ startX, endX: startX + w, centerY }};

                    const alertInfo = getAlertInfo(t);
                    let barColor = t.level === 1 ? 'var(--neon-purple)' : 'var(--neon-blue)';
                    let textColor = t.level === 1 ? '#fff' : '#000';
                    let glowColor = barColor;

                    if (alertInfo) {{
                        if (alertInfo.type === 'overdue') {{
                            barColor = 'var(--neon-red)';
                            textColor = '#fff';
                            glowColor = 'var(--neon-red)';
                        }} else {{
                            barColor = 'var(--neon-amber)';
                            textColor = '#000';
                            glowColor = 'var(--neon-amber)';
                        }}
                    }}

                    const prog = (parseFloat(t.progress || 0) * 100).toFixed(0);
                    barsHtml += `
                        <div class="g-bar"
                             data-task-id="${{t.id}}"
                             onclick="openTaskDetail('${{t.id}}', false)"
                             onmouseenter="highlightDeps('${{t.id}}')"
                             onmouseleave="clearDepHighlight()"
                             style="top:${{yOffset + 8}}px; left:${{startX}}px; width:${{w}}px; background:${{barColor}}; color:${{textColor}}; box-shadow: 0 0 8px ${{glowColor}};"
                             title="[ID:${{escapeHtml(t.id)}}] ${{escapeHtml(t.name)}} (${{t.start}} 〜 ${{t.end}} / 進捗:${{prog}}%)">
                            ${{w > 28 ? prog + '%' : ''}}
                        </div>`;
                }}
                yOffset += rowHeight;
            }});

            if (showDepLines) {{
                const edgeSet = new Set();
                const edges = [];

                visibleTasks.forEach(t => {{
                    (t.predecessors || []).forEach(predId => {{
                        const key = `${{predId}}->${{t.id}}`;
                        if (!edgeSet.has(key)) {{
                            edgeSet.add(key);
                            edges.push({{ from: predId, to: t.id }});
                        }}
                    }});
                    (t.successors || []).forEach(succId => {{
                        const key = `${{t.id}}->${{succId}}`;
                        if (!edgeSet.has(key)) {{
                            edgeSet.add(key);
                            edges.push({{ from: t.id, to: succId }});
                        }}
                    }});
                }});

                let pathsHtml = '';
                edges.forEach(edge => {{
                    const fromPos = barPosMap[edge.from];
                    const toPos = barPosMap[edge.to];
                    if (!fromPos || !toPos) return;

                    const x1 = fromPos.endX;
                    const y1 = fromPos.centerY;
                    const x2 = toPos.startX;
                    const y2 = toPos.centerY;
                    const gap = 10;

                    let d = '';
                    if (x2 >= x1 + gap) {{
                        const midX = x1 + gap;
                        d = `M ${{x1}} ${{y1}} L ${{midX}} ${{y1}} L ${{midX}} ${{y2}} L ${{x2}} ${{y2}}`;
                    }} else {{
                        const outX = x1 + gap;
                        const inX = Math.max(0, x2 - gap);
                        const midY = y1 + (y2 > y1 ? rowHeight / 2 : -rowHeight / 2);
                        d = `M ${{x1}} ${{y1}} L ${{outX}} ${{y1}} L ${{outX}} ${{midY}} L ${{inX}} ${{midY}} L ${{inX}} ${{y2}} L ${{x2}} ${{y2}}`;
                    }}

                    pathsHtml += `<path class="dep-path" data-from="${{edge.from}}" data-to="${{edge.to}}" d="${{d}}" marker-end="url(#dep-arrow)" />`;
                }});

                const totalWidth = totalDays * dayWidth;
                barsHtml += `
                    <svg class="dep-svg" width="${{totalWidth}}" height="${{yOffset}}">
                        <defs>
                            <marker id="dep-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                                <path d="M 0 1 L 7 4 L 0 7 z" fill="#00f3ff" />
                            </marker>
                        </defs>
                        ${{pathsHtml}}
                    </svg>`;
            }}

            labelsContainer.innerHTML = labelsHtml;
            timelineContainer.innerHTML = barsHtml;
            timelineContainer.style.width = (totalDays * dayWidth) + 'px';
            timelineContainer.style.height = yOffset + 'px';
        }}

        function highlightDeps(taskId) {{
            const paths = document.querySelectorAll('.dep-path');
            if (!paths.length) return;
            paths.forEach(p => {{
                if (p.dataset.from === taskId || p.dataset.to === taskId) {{
                    p.classList.add('highlighted');
                    p.classList.remove('dimmed');
                }} else {{
                    p.classList.add('dimmed');
                    p.classList.remove('highlighted');
                }}
            }});
        }}

        function clearDepHighlight() {{
            document.querySelectorAll('.dep-path').forEach(p => {{
                p.classList.remove('highlighted', 'dimmed');
            }});
        }}

        function syncScroll() {{
            const timeline = document.getElementById('gantt-scroll');
            const labels = document.getElementById('gantt-labels');
            labels.scrollTop = timeline.scrollTop;
        }}

        document.addEventListener('DOMContentLoaded', () => {{
            initData();
            renderAlerts();
            renderDashboard();
            renderTable();
        }});
    </script>
</body>
</html>"""

        output_dir = os.path.dirname(os.path.abspath(file_path))
        output_file = os.path.join(output_dir, 'cyber_wbs_dashboard.html')

        with open(output_file, 'w', encoding='utf-8') as f:
            f.write(html_content)

